# ══════════════════════════════════════════════════════════════════════════════════════
#  basedb — configuration
#
#  Copiez ce fichier en `.env`, à côté de `docker-compose.yml` : `docker compose` le lit,
#  et `pnpm start` (la pile de développement) aussi. Une valeur vide vaut « non défini ».
#
#  Deux valeurs sont OBLIGATOIRES pour Docker : POSTGRES_PASSWORD et
#  BASEDB_ENCRYPTION_KEY. Tout le reste a une valeur par défaut raisonnable.
# ══════════════════════════════════════════════════════════════════════════════════════


# ── Base de données ───────────────────────────────────────────────────────────────────
# Le conteneur `db` (PostgreSQL 16). Les tables de basedb sont de vraies tables :
# `psql "postgres://basedb:<mot de passe>@localhost:5432/basedb"` les lit directement.
POSTGRES_USER=basedb
POSTGRES_PASSWORD=
POSTGRES_DB=basedb
# Port publié sur 127.0.0.1 pour psql et vos outils SQL.
# POSTGRES_PORT=5432

# Une base PostgreSQL 16+ à vous plutôt que le conteneur `db` (rôle propriétaire de la
# base, extensions pg_trgm et unaccent disponibles).
# DATABASE_URL=postgres://basedb:secret@db.example.com:5432/basedb


# ── Clé d'instance ────────────────────────────────────────────────────────────────────
# Signe les sessions et chiffre les secrets (clés d'IA, jetons, liens de formulaires).
# La changer déconnecte tout le monde et rend
# illisibles les secrets déjà enregistrés : générez-la une fois, gardez-la.
#   openssl rand -base64 32
BASEDB_ENCRYPTION_KEY=


# ── Premier démarrage ─────────────────────────────────────────────────────────────────
# Sur une base vide, l'API crée le catalogue. Aux démarrages suivants, c'est sans effet.
# BASEDB_MIGRATE=1
# BASEDB_BOOTSTRAP=1
# Référence du tenant (7 caractères), dans toutes les URL de l'API : /api/v1/<tenant>/…
# BASEDB_TENANT=t4z56fq
# Le premier administrateur. Laissé vide, la PREMIÈRE PERSONNE qui ouvre l'interface le
# crée, avec son adresse et son mot de passe : ouvrez-la avant de publier l'instance sur
# un domaine. Défini, l'API le crée au premier démarrage.
# BASEDB_ADMIN_EMAIL=
# Avec BASEDB_ADMIN_EMAIL, et laissé vide : un mot de passe est généré et affiché UNE
# fois (`docker compose logs basedb`). Défini, il est réappliqué à l'administrateur à
# CHAQUE démarrage — pratique pour reprendre la main, à retirer une fois connecté.
# BASEDB_ADMIN_PASSWORD=


# ── Adresse et ports ──────────────────────────────────────────────────────────────────
# L'image eodia/basedb sert tout sur une seule adresse : l'interface, l'API sous /api et
# le serveur MCP sous /mcp. Port publié sur 127.0.0.1 par docker compose :
# BASEDB_PORT=3000
# La version de l'image (docker compose up -d la télécharge) : `latest` par défaut.
# BASEDB_VERSION=0.3.1

# L'adresse publique, pour le retour d'une connexion OIDC (Google, Entra ID…) :
# comparée caractère par caractère à celle enregistrée chez le fournisseur.
# BASEDB_PUBLIC_URL=https://basedb.example.com
# D'autres sites dont les pages appellent l'API depuis le navigateur, séparés par des
# virgules. Inutile pour l'interface de basedb, servie à la même adresse que l'API.
# BASEDB_ORIGINS=https://intranet.example.com

# Un domaine en HTTPS (Caddy, certificats automatiques) :
#   docker compose --profile https up -d
# BASEDB_DOMAIN=basedb.example.com


# ── Connexion avec Google, Microsoft… (OIDC) ──────────────────────────────────────────
# Les fournisseurs proposés sur l'écran de connexion, séparés par des virgules. Pour
# chacun, l'adresse de retour à enregistrer chez lui : BASEDB_PUBLIC_URL (ci-dessus, à
# définir) suivi de /auth/oidc/<nom>/callback.
# BASEDB_OIDC_PROVIDERS=google,microsoft
#
# Google (console.cloud.google.com → Identifiants → ID client OAuth, application Web) :
# BASEDB_OIDC_GOOGLE_CLIENT_ID=
# BASEDB_OIDC_GOOGLE_CLIENT_SECRET=
#
# Microsoft (Entra ID → Inscriptions d'applications) : l'émetteur nomme l'organisation.
# BASEDB_OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/<id-organisation>/v2.0
# BASEDB_OIDC_MICROSOFT_CLIENT_ID=
# BASEDB_OIDC_MICROSOFT_CLIENT_SECRET=
#
# Tout autre fournisseur OIDC (Keycloak, Authentik, GitLab, Okta…), sous le nom choisi :
# BASEDB_OIDC_SSO_ISSUER=https://sso.example.com/realms/equipe
# BASEDB_OIDC_SSO_CLIENT_ID=
# BASEDB_OIDC_SSO_CLIENT_SECRET=
# BASEDB_OIDC_SSO_LABEL=SSO de l'entreprise
#
# Une première connexion crée le compte, comme l'inscription le permet (réglée dans
# l'administration : ouverte, fermée, domaines). Pour n'admettre que les comptes existants :
# BASEDB_OIDC_GOOGLE_SIGNUP=off

# Pile de développement seulement (`pnpm start`, trois processus sur trois ports) : les
# adresses de l'API et du MCP telles que le navigateur les voit. L'image les fixe seule.
# BASEDB_API=http://localhost:8787
# BASEDB_MCP=http://localhost:8788/mcp


# ── Fichiers (champs Document et Image) ───────────────────────────────────────────────
# Par défaut, le volume `files` du conteneur basedb. Taille maximale d'un fichier, en Mo.
# BASEDB_FILES_MAX_MB=25
# Ou un stockage compatible S3 : AWS, Scaleway, OVH, Cloudflare R2, Garage, MinIO…
# BASEDB_S3_BUCKET=basedb
# BASEDB_S3_ENDPOINT=https://s3.fr-par.scw.cloud
# BASEDB_S3_REGION=fr-par
# BASEDB_S3_ACCESS_KEY_ID=
# BASEDB_S3_SECRET_ACCESS_KEY=
# Adressage par chemin (bucket dans le chemin), par défaut ; 0 pour l'adressage par hôte.
# BASEDB_S3_FORCE_PATH_STYLE=1


# ── Intelligence artificielle ─────────────────────────────────────────────────────────
# Fournisseur et modèle de l'instance, tant qu'aucun réglage n'est enregistré dans
# l'interface (un réglage enregistré l'emporte). Fournisseurs : openai, anthropic, mistral,
# et openai_compatible — tout serveur à l'API d'OpenAI : Azure, une passerelle, Ollama…
# BASEDB_AI_PROVIDER=mistral
# BASEDB_AI_MODEL=mistral-large-latest
# La clé : BASEDB_AI_API_KEY, ou la variable habituelle du fournisseur.
# BASEDB_AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# L'adresse du fournisseur, à la place de la sienne — obligatoire pour openai_compatible :
# ce qui précède /chat/completions (/messages pour anthropic), paramètres compris.
# BASEDB_AI_BASE_URL=https://ma-ressource.openai.azure.com/openai/v1
# Des en-têtes ajoutés à chaque appel, en objet JSON (ils remplacent ceux de la clé) :
# BASEDB_AI_HEADERS='{"api-key":"…"}'
# Plafonds par tenant et par heure : appels interactifs (brouillons, copilote)…
# BASEDB_AI_QUOTA=120
# … et calculs de cellules des champs IA.
# BASEDB_AI_FIELD_QUOTA=300
# 0 : pas de calcul des champs IA dans ce processus (un second processus API sur la
# même base, par exemple ; un seul suffit).
# BASEDB_AI_WORKER=1


# ── Modèles de base ───────────────────────────────────────────────────────────────────
# Le catalogue que la galerie de modèles lit : par défaut celui du site public
# (https://eodia.github.io/basedb/modeles/catalogue.json). Une autre adresse pour servir
# le vôtre, « off » pour n’en lire aucun — les modèles intégrés restent.
# BASEDB_TEMPLATES_URL=off


# ── Démo publique ─────────────────────────────────────────────────────────────────────
# Une instance ouverte à tous : l'écran de connexion préremplit un compte partagé ; on y lit
# tout et modifie ce qui existe, sans rien créer ni supprimer, et sans IA. Pour tous les
# comptes, administrateur compris : créez d'abord ce qu'il faut.
# BASEDB_DEMO=1
# Un compte par langue, préparé à l'avance avec son projet, et leur mot de passe commun,
# publié avec eux. Sans eux, le compte partagé est l'administrateur de BASEDB_ADMIN_EMAIL.
# BASEDB_DEMO_ACCOUNTS=fr=demo@demo.com,en=demo-en@demo.com
# BASEDB_DEMO_PASSWORD=


# ── Développement seulement ───────────────────────────────────────────────────────────
# Affiche les courriels (liens de réinitialisation) dans les journaux au lieu de les
# envoyer. Jamais en production : un lien dans un journal est un lien utilisable.
# BASEDB_DEV_MAIL=1
# Autorise les webhooks vers HTTP et les adresses locales.
# BASEDB_WEBHOOK_DEV=1
