# ══════════════════════════════════════════════════════════════════════════════════════
#  basedb — configuration
#
#  Copiez ce fichier en `.env` à la racine du dépôt : `docker compose` le lit, et
#  `pnpm start` (la pile de développement) aussi. Une valeur vide vaut « non défini ».
#
#  Deux valeurs sont OBLIGATOIRES pour Docker : POSTGRES_PASSWORD et
#  BASEDB_ENCRYPTION_KEY. Tout le reste a une valeur par défaut raisonnable.
# ══════════════════════════════════════════════════════════════════════════════════════


# ── Base de données ───────────────────────────────────────────────────────────────────
# Le conteneur `db` (PostgreSQL 16). Les tables de basedb sont de vraies tables :
# `psql "postgres://basedb:<mot de passe>@localhost:5432/basedb"` les lit directement.
POSTGRES_USER=basedb
POSTGRES_PASSWORD=
POSTGRES_DB=basedb
# Port publié sur 127.0.0.1 pour psql et vos outils SQL.
# POSTGRES_PORT=5432

# Une base PostgreSQL 16+ à vous plutôt que le conteneur `db` (rôle propriétaire de la
# base, extensions pg_trgm et unaccent disponibles).
# DATABASE_URL=postgres://basedb:secret@db.example.com:5432/basedb


# ── Clé d'instance ────────────────────────────────────────────────────────────────────
# Signe les sessions et chiffre les secrets (clés d'IA, jetons, liens de formulaires).
# Partagée par l'API et le serveur MCP. La changer déconnecte tout le monde et rend
# illisibles les secrets déjà enregistrés : générez-la une fois, gardez-la.
#   openssl rand -base64 32
BASEDB_ENCRYPTION_KEY=


# ── Premier démarrage ─────────────────────────────────────────────────────────────────
# Sur une base vide, l'API crée le catalogue et le premier administrateur. Aux
# démarrages suivants, les deux sont sans effet.
# BASEDB_MIGRATE=1
# BASEDB_BOOTSTRAP=1
# Référence du tenant (7 caractères), dans toutes les URL de l'API : /api/v1/<tenant>/…
# BASEDB_TENANT=t4z56fq
# BASEDB_ADMIN_EMAIL=admin@basedb.local
# Laissé vide, un mot de passe est généré et affiché UNE fois : `docker compose logs api`.
# Défini, il est réappliqué à CHAQUE démarrage — pratique pour reprendre la main,
# à retirer une fois connecté.
# BASEDB_ADMIN_PASSWORD=


# ── Adresses ──────────────────────────────────────────────────────────────────────────
# Telles que le NAVIGATEUR les voit. Par défaut, tout est sur localhost.
# BASEDB_API=http://localhost:8787
# BASEDB_MCP=http://localhost:8788/mcp
# Origines autorisées à appeler l'API depuis un navigateur, séparées par des virgules.
# Non défini : toute origine http://localhost est acceptée (développement seulement).
# BASEDB_ORIGINS=https://basedb.example.com
# Adresse publique de l'API, pour le retour de connexion OIDC (Google, Entra ID…) :
# comparée caractère par caractère à celle enregistrée chez le fournisseur.
# BASEDB_PUBLIC_URL=https://basedb.example.com

# Ports publiés sur 127.0.0.1 par docker compose.
# BASEDB_WEB_PORT=3000
# BASEDB_API_PORT=8787
# BASEDB_MCP_PORT=8788

# Un domaine en HTTPS (Caddy, certificats automatiques) :
#   docker compose --profile https up -d
# puis BASEDB_API, BASEDB_MCP, BASEDB_ORIGINS et BASEDB_PUBLIC_URL sur ce domaine
# (voir docker/Caddyfile).
# BASEDB_DOMAIN=basedb.example.com


# ── Fichiers (champs Document et Image) ───────────────────────────────────────────────
# Par défaut, le volume `files` de l'API. Taille maximale d'un fichier, en Mo.
# BASEDB_FILES_MAX_MB=25
# Ou un stockage compatible S3 : AWS, Scaleway, OVH, Cloudflare R2, Garage, MinIO…
# BASEDB_S3_BUCKET=basedb
# BASEDB_S3_ENDPOINT=https://s3.fr-par.scw.cloud
# BASEDB_S3_REGION=fr-par
# BASEDB_S3_ACCESS_KEY_ID=
# BASEDB_S3_SECRET_ACCESS_KEY=
# Adressage par chemin (bucket dans le chemin), par défaut ; 0 pour l'adressage par hôte.
# BASEDB_S3_FORCE_PATH_STYLE=1


# ── Intelligence artificielle ─────────────────────────────────────────────────────────
# Fournisseur et modèle de l'instance, tant qu'aucun réglage n'est enregistré dans
# l'interface (un réglage enregistré l'emporte). Fournisseurs : openai, anthropic, mistral.
# BASEDB_AI_PROVIDER=mistral
# BASEDB_AI_MODEL=mistral-large-latest
# La clé : BASEDB_AI_API_KEY, ou la variable habituelle du fournisseur.
# BASEDB_AI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# Plafonds par tenant et par heure : appels interactifs (brouillons, copilote)…
# BASEDB_AI_QUOTA=120
# … et calculs de cellules des champs IA.
# BASEDB_AI_FIELD_QUOTA=300
# 0 : pas de calcul des champs IA dans ce processus (un second processus API sur la
# même base, par exemple ; un seul suffit).
# BASEDB_AI_WORKER=1


# ── Modèles de base ───────────────────────────────────────────────────────────────────
# Le catalogue que la galerie de modèles lit : par défaut celui du site public
# (https://eodia.github.io/basedb/modeles/catalogue.json). Une autre adresse pour servir
# le vôtre, « off » pour n’en lire aucun — les modèles intégrés restent.
# BASEDB_TEMPLATES_URL=off


# ── Développement seulement ───────────────────────────────────────────────────────────
# Affiche les courriels (liens de réinitialisation) dans les journaux au lieu de les
# envoyer. Jamais en production : un lien dans un journal est un lien utilisable.
# BASEDB_DEV_MAIL=1
# Autorise les webhooks vers HTTP et les adresses locales.
# BASEDB_WEBHOOK_DEV=1
