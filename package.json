{
  "name": "basedb",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && node scripts/catalog-migrations.mjs check",
    "format": "biome format --write .",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:int": "turbo run test:int",
    "test:vol": "turbo run test:vol",
    "test:panne": "turbo run test:panne",
    "graph": "depcruise packages apps --config tooling/dependency-cruiser/.dependency-cruiser.cjs",
    "demo": "node scripts/demo.mjs",
    "catalog": "node scripts/catalog-migrations.mjs",
    "i18n": "node tooling/i18n/extract.mjs && node tooling/i18n/check.mjs",
    "start": "node scripts/start.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@testcontainers/postgresql": "^10.16.0",
    "dependency-cruiser": "^16.9.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  }
}
