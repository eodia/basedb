{
  "name": "basedb",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && node scripts/catalog-migrations.mjs check",
    "format": "biome format --write .",
    "test": "turbo run test:unit",
    "test:unit": "turbo run test:unit",
    "test:server": "cargo test --manifest-path rust-server/Cargo.toml --workspace",
    "graph": "depcruise packages apps --config tooling/dependency-cruiser/.dependency-cruiser.cjs",
    "catalog": "node scripts/catalog-migrations.mjs",
    "i18n": "node tooling/i18n/extract.mjs && node tooling/i18n/check.mjs",
    "dev": "node scripts/start.mjs",
    "start": "node scripts/start.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "dependency-cruiser": "^18.8.0",
    "turbo": "^2.11.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
