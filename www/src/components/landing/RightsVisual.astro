---
/* Group levels flowing down a project, a field hidden from one group, and one line of history. */
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, html } = i18n(locale);
const v = t.rightsVisual;
const rows = [
	{ depth: 0, icon: 'project', label: v.project, level: 'read', inherited: false },
	{ depth: 1, icon: 'base', label: v.sales, level: 'edit', inherited: false },
	{ depth: 2, icon: 'table', label: v.opportunities, level: 'edit', inherited: true },
	{ depth: 2, icon: 'table', label: v.clients, level: 'edit', inherited: true },
	{ depth: 1, icon: 'base', label: v.support, level: 'read', inherited: true },
] as const;
const LEVEL = v.levels;
---

<div class="rv">
	<div class="card perms">
		<div class="top">
			<div class="groups">
				{v.groups.map((g, i) => <span class:list={['g', { on: i === 1 }]}>{g}</span>)}
			</div>
		</div>
		<div class="tree">
			{
				rows.map((r) => (
					<div class="row" style={`--depth: ${r.depth}`}>
						<span class:list={['ic', r.icon]} />
						<span class="lbl">{r.label}</span>
						{r.inherited && <span class="inh">{v.inherited}</span>}
						<span class:list={['lvl', r.level]}>{LEVEL[r.level]}</span>
					</div>
				))
			}
			<div class="row field" style="--depth: 3">
				<span class="ic field-ic"></span>
				<span class="lbl">{v.field}</span>
				<span class="lvl hidden">{v.hidden}</span>
			</div>
		</div>
	</div>

	<div class="card hist">
		<div class="who">
			<span class="av">&gt;_</span>
			<div>
				<p set:html={html(v.sqlChange)} />
				<small>{v.sqlMeta}</small>
				<p class="diff" set:html={html(v.sqlDiff)} />
			</div>
			<span class="undo">{v.undo}</span>
		</div>
		<div class="who">
			<span class="av form">▣</span>
			<div>
				<p set:html={html(v.formChange)} />
				<small>{v.formMeta}</small>
			</div>
		</div>
	</div>
</div>

<style>
	.rv {
		position: relative;
		padding-bottom: 150px;
	}
	.card {
		border-radius: 14px;
		border: 1px solid var(--bd-border);
		background: #fff;
		box-shadow: 0 18px 40px -22px rgba(16, 24, 16, 0.3);
	}
	.perms {
		overflow: hidden;
		margin-right: 40px;
	}
	.top {
		padding: 12px 14px;
		border-bottom: 1px solid var(--bd-border-subtle);
		background: var(--bd-alt-bg);
	}
	.groups {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
	}
	.g {
		font-size: 12px;
		font-weight: 600;
		padding: 5px 10px;
		border-radius: 8px;
		color: var(--bd-text-soft);
		border: 1px solid transparent;
	}
	.g.on {
		background: #fff;
		border-color: var(--bd-border);
		color: var(--bd-text);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
	}
	.tree {
		padding: 4px 0;
	}
	.row {
		display: flex;
		align-items: center;
		gap: 9px;
		padding: 9px 14px 9px calc(14px + var(--depth) * 20px);
		border-bottom: 1px solid var(--bd-border-subtle);
		font-size: 13.5px;
	}
	.row:last-child {
		border-bottom: 0;
	}
	.ic {
		width: 14px;
		height: 14px;
		border-radius: 3px;
		border: 1.6px solid #7a7f78;
		flex-shrink: 0;
	}
	.ic.base {
		border-radius: 50% / 30%;
	}
	.ic.field-ic {
		border-style: dashed;
	}
	.lbl {
		font-weight: 600;
	}
	.field .lbl {
		font-weight: 500;
		color: var(--bd-text-soft);
	}
	.inh {
		font-size: 11px;
		color: var(--bd-muted-fg);
	}
	.lvl {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 12px;
		font-weight: 600;
		padding: 4px 10px;
		border-radius: 8px;
		border: 1px solid var(--bd-border);
		min-width: 104px;
	}
	.lvl::before {
		content: '';
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: currentColor;
	}
	.lvl.read {
		color: #2563eb;
	}
	.lvl.edit {
		color: #15803d;
	}
	.lvl.manage {
		color: #7c3aed;
	}
	.lvl.hidden {
		color: #b45309;
		background: #fff7e6;
		border-color: #fde2b3;
	}
	.hist {
		position: absolute;
		right: 0;
		bottom: 0;
		width: min(92%, 440px);
		padding: 6px 0;
		box-shadow: 0 30px 60px -24px rgba(16, 24, 16, 0.4);
	}
	.who {
		display: flex;
		gap: 10px;
		padding: 10px 14px;
		font-size: 12.5px;
	}
	.who + .who {
		border-top: 1px solid var(--bd-border-subtle);
	}
	.who p {
		margin: 0;
		color: var(--bd-text-soft);
	}
	.who :global(b) {
		color: var(--bd-text);
	}
	.who small {
		color: var(--bd-muted-fg);
		font-size: 11px;
	}
	.diff {
		margin-top: 4px !important;
	}
	.diff :global(s) {
		color: var(--bd-muted-fg);
	}
	.av {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: var(--bd-muted);
		font-family: var(--bd-font-mono);
		font-size: 10px;
		flex-shrink: 0;
	}
	.av.form {
		font-family: inherit;
		font-size: 12px;
	}
	.undo {
		margin-left: auto;
		font-size: 11.5px;
		font-weight: 600;
		white-space: nowrap;
	}
</style>
