---
/* A field created in the interface, and what PostgreSQL receives. */
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const v = i18n(locale).t.sqlVisual;
// The description is also the column's comment, a SQL string.
const comment = `'${v.descriptionValue.replace(/'/g, "''")}'`;
---

<div class="sv">
	<div class="card form">
		<div class="card-top">
			<span class="pill">{v.interface}</span>
			<span class="title">{v.title}</span>
		</div>
		<div class="fields">
			<label><span>{v.labelField}</span><b>{v.labelValue}</b></label>
			<label>
				<span>{v.typeField}</span>
				<b class="type"><i>#</i> {v.typeValue}</b>
			</label>
			<label><span>{v.descriptionField}</span><b class="soft">{v.descriptionValue}</b></label>
			<div class="toggles">
				<span class="tg"><i></i>{v.required}</span>
				<span class="tg"><i></i>{v.ai}</span>
			</div>
		</div>
	</div>

	<div class="arrow" aria-hidden="true">
		<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"></path></svg>
		<span>{v.migration}</span>
	</div>

	<div class="card code">
		<div class="card-top dark">
			<span class="pill green">PostgreSQL</span>
			<span class="title">b_t4z56fq_ventes.opportunites</span>
		</div>
		<pre><span class="k">ALTER TABLE</span> b_t4z56fq_ventes.opportunites
  <span class="k">ADD COLUMN</span> montant <span class="t">numeric(38,10)</span>;
<span class="k">COMMENT ON COLUMN</span> …opportunites.montant
  <span class="k">IS</span> <span class="s">{comment}</span>;</pre>
		<div class="psql">
			<span class="p">basedb=&gt;</span> \d opportunites
			<table>
				<tbody>
					<tr><td>nom</td><td>text</td></tr>
					<tr><td>statut</td><td>text</td></tr>
					<tr class="hl"><td>montant</td><td>numeric(38,10)</td></tr>
					<tr><td>echeance</td><td>date</td></tr>
					<tr><td>clients_id</td><td>uuid → clients</td></tr>
				</tbody>
			</table>
		</div>
	</div>
</div>

<style>
	.sv {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 10px;
	}
	.card {
		border-radius: 14px;
		border: 1px solid var(--bd-border);
		background: #fff;
		box-shadow: 0 18px 40px -22px rgba(16, 24, 16, 0.3);
		overflow: hidden;
	}
	.card-top {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 10px 14px;
		border-bottom: 1px solid var(--bd-border-subtle);
		font-size: 12.5px;
		color: var(--bd-muted-fg);
	}
	.card-top.dark {
		border-color: rgba(255, 255, 255, 0.08);
		color: #9fb09b;
	}
	.title {
		font-weight: 600;
	}
	.pill {
		font-size: 10.5px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		padding: 3px 8px;
		border-radius: 999px;
		background: var(--bd-muted);
		color: var(--bd-text-soft);
	}
	.pill.green {
		background: rgba(63, 203, 42, 0.16);
		color: var(--bd-primary-vivid);
	}
	.fields {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 12px 16px;
		padding: 16px;
	}
	label {
		display: flex;
		flex-direction: column;
		gap: 5px;
		font-size: 11.5px;
		color: var(--bd-muted-fg);
		font-weight: 500;
	}
	label:nth-child(3) {
		grid-column: 1 / -1;
	}
	label b {
		font-size: 13.5px;
		font-weight: 600;
		color: var(--bd-text);
		border: 1px solid var(--bd-border);
		border-radius: 8px;
		padding: 7px 10px;
	}
	label b.soft {
		font-weight: 500;
		color: var(--bd-text-soft);
	}
	.type i {
		font-style: normal;
		color: var(--bd-muted-fg);
		margin-right: 4px;
	}
	.toggles {
		display: flex;
		gap: 18px;
		grid-column: 1 / -1;
		font-size: 13px;
		font-weight: 500;
	}
	.tg {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: var(--bd-text-soft);
	}
	.tg i {
		position: relative;
		width: 28px;
		height: 16px;
		border-radius: 999px;
		background: #d9dcd6;
	}
	.tg i::after {
		content: '';
		position: absolute;
		top: 2px;
		left: 2px;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
	}
	.tg.on i {
		background: var(--bd-primary);
	}
	.tg.on i::after {
		left: 14px;
	}
	.arrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		color: var(--bd-primary);
		font-size: 12.5px;
		font-weight: 600;
	}
	.code {
		background: var(--bd-ink);
		border-color: #1d2a1f;
	}
	pre {
		margin: 0;
		padding: 14px 16px;
		color: #d8e6d4;
		font-size: 12.5px;
		line-height: 1.6;
		overflow-x: auto;
	}
	.k {
		color: #7fd46d;
	}
	.t {
		color: #8cc8ff;
	}
	.s {
		color: #f5c26b;
	}
	.psql {
		font-variant-ligatures: none;
		border-top: 1px dashed rgba(255, 255, 255, 0.1);
		padding: 12px 16px 14px;
		color: #d8e6d4;
		font-family: var(--bd-font-mono);
		font-size: 12px;
	}
	.p {
		color: var(--bd-primary-vivid);
	}
	table {
		margin-top: 8px;
		border-collapse: collapse;
		width: 100%;
	}
	td {
		padding: 3px 8px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		color: #b9c8b5;
	}
	td:first-child {
		color: #eaf3e7;
		width: 40%;
	}
	tr.hl td {
		background: rgba(63, 203, 42, 0.14);
		color: #fff;
	}
</style>
