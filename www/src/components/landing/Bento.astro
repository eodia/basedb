---
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, href } = i18n(locale);
const b = t.bento;
const tones = ['green', 'blue', 'violet', 'amber', 'ink'];
const small = Object.values(b.small);
---

<section class="bd-bento" id="fonctionnalites-plus">
	<div class="bd-section-head bd-reveal">
		<span class="bd-label">{b.label}</span>
		<h2>{b.title}</h2>
		<p>{b.text}</p>
	</div>

	<div class="grid">
		<article class="card wide views bd-reveal">
			<h3>{b.views.title}</h3>
			<p>{b.views.text}</p>
			<div class="chips">
				{b.views.chips.map((v, i) => <span class:list={['view', `v${i}`]}>{v}</span>)}
			</div>
		</article>

		<article class="card forms bd-reveal">
			<h3>{b.forms.title}</h3>
			<p>{b.forms.text}</p>
			<div class="link">
				<span class="lock">🔗</span>
				<code>/f/uIPJZ4Ensr_K8V0In0bb…</code>
			</div>
			<a href={href(b.forms.href)}>{b.more}</a>
		</article>

		<article class="card envs bd-reveal">
			<h3>{b.environments.title}</h3>
			<p>{b.environments.text}</p>
			<div class="envline">
				{b.environments.chips.map((e, i) => <span class:list={['env', ['prod', 'rec', 'dev'][i]]}>{e}</span>)}
			</div>
			<a href={href(b.environments.href)}>{b.more}</a>
		</article>

		<article class="card wide collab bd-reveal">
			<h3>{b.collaboration.title}</h3>
			<p>{b.collaboration.text}</p>
			<div class="actors">
				{b.collaboration.chips.map((c, i) => <span class:list={['actor', tones[i % tones.length]]}>{c}</span>)}
			</div>
			<a href={href(b.collaboration.href)}>{b.more}</a>
		</article>

		{
			small.map((s) => (
				<a class="card small bd-reveal" href={href(s.href)}>
					<h3>{s.title}</h3>
					<p>{s.text}</p>
					{s.code !== undefined && <code class="prompt">{s.code}</code>}
				</a>
			))
		}
	</div>
</section>

<style>
	.bd-bento {
		max-width: 1200px;
		margin: 0 auto;
		padding: 96px 24px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 16px;
	}
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 24px;
		border-radius: 18px;
		border: 1px solid var(--bd-border);
		background: #fff;
		transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
	}
	a.card:hover,
	.card:hover {
		border-color: #cfe0ca;
		box-shadow: 0 14px 34px -20px rgba(16, 24, 16, 0.28);
	}
	a.card:hover {
		transform: translateY(-2px);
	}
	.wide {
		grid-column: span 2;
	}
	h3 {
		margin: 0;
		font-size: 17px;
		font-weight: 700;
		letter-spacing: -0.015em;
	}
	p {
		margin: 0;
		font-size: 14px;
		line-height: 1.6;
		color: var(--bd-text-soft);
	}
	.card > a {
		margin-top: auto;
		padding-top: 6px;
		font-size: 13.5px;
		font-weight: 600;
		color: var(--bd-primary);
	}
	.views {
		background:
			radial-gradient(400px 200px at 90% 110%, rgba(63, 203, 42, 0.12), transparent 70%),
			#fff;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 8px;
	}
	.view {
		font-size: 13px;
		font-weight: 600;
		padding: 8px 14px;
		border-radius: 10px;
		border: 1px solid var(--bd-border);
		background: var(--bd-alt-bg);
	}
	.v0 { color: #15803d; }
	.v1 { color: #c26a05; }
	.v2 { color: #2563eb; }
	.v3 { color: #0e7490; }
	.v4 { color: #7c3aed; }
	.v5 { color: #b45309; }
	.v6 { color: #4f46e5; }
	.v7 { color: #be185d; }
	.link {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 9px 12px;
		border-radius: 10px;
		background: var(--bd-ink);
		color: #d8e6d4;
		font-size: 12.5px;
		overflow: hidden;
	}
	.link code {
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.envline {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.env {
		font-size: 12px;
		font-weight: 600;
		padding: 4px 10px;
		border-radius: 999px;
	}
	.env.prod {
		background: #e5f6e1;
		color: #1f7a14;
	}
	.env.rec {
		background: #fdf1dc;
		color: #b45309;
	}
	.env.dev {
		background: #e6effd;
		color: #1d4ed8;
	}
	.collab {
		background:
			radial-gradient(420px 220px at 0% 120%, rgba(124, 58, 237, 0.08), transparent 70%),
			#fff;
	}
	.actors {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 4px;
	}
	.actor {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-size: 12.5px;
		font-weight: 600;
		padding: 6px 11px;
		border-radius: 999px;
		border: 1px solid var(--bd-border);
		background: #fff;
	}
	.actor::before {
		content: '';
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: currentColor;
	}
	.actor.green { color: #15803d; }
	.actor.blue { color: #2563eb; }
	.actor.violet { color: #7c3aed; }
	.actor.amber { color: #c26a05; }
	.actor.ink { color: #1f2a20; }
	.small h3 {
		font-size: 15.5px;
	}
	.small p {
		font-size: 13.5px;
	}
	.prompt {
		align-self: flex-start;
		font-size: 12px;
		padding: 5px 9px;
		border-radius: 8px;
		background: #f4efff;
		color: #6d28d9;
	}
	@media (max-width: 960px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.wide {
			grid-column: auto;
		}
	}
</style>
