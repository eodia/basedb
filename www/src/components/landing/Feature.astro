---
interface Props {
	id?: string;
	label: string;
	/** The title; the part between {braces} is written in the accent hand. */
	title: string;
	lead: string;
	bullets: string[];
	reverse?: boolean;
	links?: Array<{ href: string; label: string }>;
}

const { id, label, title, lead, bullets, reverse = false, links = [] } = Astro.props;
const [before, accent = '', after = ''] = title.split(/[{}]/);
---

<section class:list={['bd-feat', 'bd-reveal', { reverse }]} id={id}>
	<div class="text">
		<span class="bd-label"><slot name="icon" />{label}</span>
		<h2>{before}<span class="bd-accent">{accent}</span>{after}</h2>
		<p class="lead" set:html={lead} />
		<ul>
			{
				bullets.map((b) => (
					<li>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<polyline points="20 6 9 17 4 12" />
						</svg>
						<span set:html={b} />
					</li>
				))
			}
		</ul>
		{
			links.length > 0 && (
				<p class="links">
					{links.map((l) => (
						<a href={l.href}>
							{l.label}
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M5 12h14M13 6l6 6-6 6" />
							</svg>
						</a>
					))}
				</p>
			)
		}
	</div>
	<div class="visual">
		<slot />
	</div>
</section>

<style>
	.bd-feat {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
		gap: 64px;
		align-items: center;
		max-width: 1200px;
		margin: 0 auto;
		padding: 88px 24px;
	}
	.bd-feat.reverse .text {
		order: 2;
	}
	.bd-feat.reverse .visual {
		order: 1;
	}
	h2 {
		font-size: clamp(28px, 3.4vw, 40px);
		font-weight: 800;
		letter-spacing: -0.032em;
		line-height: 1.1;
		margin: 14px 0 18px;
	}
	.lead {
		font-size: 16.5px;
		line-height: 1.65;
		color: var(--bd-text-soft);
		margin: 0 0 22px;
	}
	.lead :global(code),
	li :global(code) {
		font-size: 0.88em;
		background: var(--bd-muted);
		padding: 1px 5px;
		border-radius: 5px;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	li {
		display: flex;
		gap: 10px;
		font-size: 15px;
		line-height: 1.5;
		color: var(--bd-text-soft);
	}
	li svg {
		flex-shrink: 0;
		margin-top: 3px;
		color: var(--bd-primary);
	}
	li :global(strong) {
		color: var(--bd-text);
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 20px;
		margin: 26px 0 0;
	}
	.links a {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 14px;
		font-weight: 600;
		color: var(--bd-primary);
	}
	.links a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.visual {
		position: relative;
	}
	@media (max-width: 960px) {
		.bd-feat {
			grid-template-columns: 1fr;
			gap: 36px;
			padding: 64px 20px;
		}
		.bd-feat.reverse .text,
		.bd-feat.reverse .visual {
			order: initial;
		}
	}
</style>
