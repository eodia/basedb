---
import Logo from './Logo.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
	{ href: `${base}/#fonctionnalites`, label: 'Fonctionnalités' },
	{ href: `${base}/guides/introduction/`, label: 'Documentation' },
	{ href: `${base}/hebergement/docker/`, label: 'Auto-hébergement' },
	{ href: `${base}/nouveautes/`, label: 'Nouveautés' },
	{ href: `${base}/feuille-de-route/`, label: 'Feuille de route' },
];
---

<header class="bd-nav-wrap">
	<nav class="bd-nav" aria-label="Navigation principale">
		<a href={`${base}/`} class="bd-nav-logo" aria-label="basedb — accueil">
			<Logo size={26} />
		</a>
		<div class="bd-nav-links">
			{links.map((l) => <a href={l.href}>{l.label}</a>)}
		</div>
		<a href="https://github.com/eodia/basedb" class="bd-nav-gh" aria-label="Le dépôt GitHub de basedb">
			<svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
				><path
					d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.39-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
				></path></svg
			>
			GitHub
		</a>
		<a href={`${base}/guides/installation/`} class="bd-nav-cta">Installer</a>
	</nav>
</header>

<style>
	.bd-nav-wrap {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 50;
		background: rgba(255, 255, 255, 0.74);
		backdrop-filter: blur(14px) saturate(180%);
		-webkit-backdrop-filter: blur(14px) saturate(180%);
		border-bottom: 1px solid rgba(10, 20, 10, 0.06);
	}
	.bd-nav {
		display: flex;
		align-items: center;
		gap: 28px;
		padding: 12px 32px;
		max-width: 1320px;
		margin: 0 auto;
	}
	.bd-nav-logo {
		display: flex;
		flex-shrink: 0;
	}
	.bd-nav-links {
		display: flex;
		gap: 26px;
		flex: 1;
		margin-left: 10px;
	}
	.bd-nav-links a {
		font-size: 13.5px;
		font-weight: 500;
		color: var(--bd-text-soft);
		transition: color 0.15s;
	}
	.bd-nav-links a:hover {
		color: var(--bd-text);
	}
	.bd-nav-gh {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		font-size: 13px;
		font-weight: 600;
		color: var(--bd-text-soft);
		padding: 6px 12px;
		border: 1px solid var(--bd-border);
		border-radius: 8px;
		background: #fff;
	}
	.bd-nav-gh:hover {
		color: var(--bd-text);
	}
	.bd-nav-cta {
		padding: 8px 16px;
		background: var(--bd-primary);
		color: #fff;
		border-radius: 8px;
		font-size: 13px;
		font-weight: 600;
		box-shadow: 0 1px 3px rgba(42, 157, 28, 0.3);
	}
	.bd-nav-cta:hover {
		background: #248a17;
	}
	@media (max-width: 960px) {
		.bd-nav {
			gap: 12px;
			padding: 12px 16px;
		}
		.bd-nav-links {
			display: none;
		}
		.bd-nav-logo {
			margin-right: auto;
		}
	}
</style>
