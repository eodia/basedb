---
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, html } = i18n(locale);
const items = Object.values(t.faq.items);
---

<section class="bd-faq bd-reveal" id="faq">
	<div class="bd-section-head">
		<span class="bd-label">{t.faq.label}</span>
		<h2>{t.faq.title}</h2>
		<p set:html={html(t.faq.text)} />
	</div>
	<div class="list">
		{
			items.map((item, i) => (
				<details open={i === 0}>
					<summary>
						{item.q}
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<polyline points="6 9 12 15 18 9" />
						</svg>
					</summary>
					<p>{item.a}</p>
				</details>
			))
		}
	</div>
</section>

<style>
	.bd-faq {
		max-width: 1200px;
		margin: 24px auto;
		padding: 88px 24px;
		background: var(--bd-alt-bg);
		border-radius: 24px;
	}
	.bd-section-head :global(a) {
		color: var(--bd-primary);
		font-weight: 600;
	}
	.list {
		max-width: 760px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	details {
		background: #fff;
		border: 1px solid var(--bd-border);
		border-radius: 14px;
		padding: 18px 22px;
	}
	details[open] {
		box-shadow: 0 10px 28px -20px rgba(16, 24, 16, 0.3);
	}
	summary {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 15px;
		font-weight: 600;
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary svg {
		margin-left: auto;
		flex-shrink: 0;
		color: var(--bd-muted-fg);
		transition: transform 0.2s ease;
	}
	details[open] summary svg {
		transform: rotate(180deg);
	}
	details p {
		margin: 12px 0 0;
		font-size: 14.5px;
		line-height: 1.65;
		color: var(--bd-text-soft);
	}
</style>
