---
/**
 * The templates, in a row one scrolls sideways — each card in its template's colour —,
 * and a last one for the base described to the AI. Buttons step through it.
 */
import { type Locale, i18n } from '../../i18n';
import { catalog, sortForLocale, templateText } from '../../lib/modeles';
import Icon from '../landing/Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, href, plural } = i18n(locale);
const g = t.teams.gallery;
const cards = sortForLocale(locale, await catalog()).map(({ template, summary }) => ({
	key: template.key,
	color: template.color ?? '#64748b',
	text: templateText(locale, template),
	counts: `${plural(t.gallery.tables, summary.counts.tables)} · ${plural(t.gallery.views, summary.counts.views)}`,
}));
---

<section class="tm-section gallery" data-gallery>
	<div class="head tm-rise">
		<div>
			<p class="tm-kicker">{g.eyebrow}</p>
			<h2 class="tm-display">{g.title}</h2>
			<p class="text">{g.text}</p>
		</div>
		<div class="arrows">
			<button type="button" data-prev aria-label={g.previous}><Icon name="chevronLeft" size={20} stroke={2.2} /></button>
			<button type="button" data-next aria-label={g.next}><Icon name="chevronRight" size={20} stroke={2.2} /></button>
		</div>
	</div>

	<ul class="row" data-row>
		{
			cards.map((c) => (
				<li>
					<a class="card" href={href(`/modeles/${c.key}/`)} style={`--c: ${c.color}`}>
						<span class="category">{c.text.category}</span>
						<b>{c.text.label}</b>
						<span class="summary">{c.text.summary}</span>
						<span class="foot">
							<span class="counts">{c.counts}</span>
							<span class="use">{g.use}</span>
						</span>
					</a>
				</li>
			))
		}
		<li>
			<a class="card ask" href={href('/modeles/')}>
				<span class="spark"><Icon name="sparkles" size={26} /></span>
				<b>{g.ask.title}</b>
				<span class="summary">{g.ask.text}</span>
				<span class="foot">
					<span class="use">{g.all}</span>
				</span>
			</a>
		</li>
	</ul>
</section>

<script>
	const section = document.querySelector<HTMLElement>('[data-gallery]');
	const row = section?.querySelector<HTMLElement>('[data-row]');
	if (section && row) {
		const step = (direction: number) => {
			const card = row.querySelector<HTMLElement>('li');
			const by = (card?.offsetWidth ?? 320) + 20;
			row.scrollBy({ left: direction * by, behavior: 'smooth' });
		};
		section.querySelector('[data-prev]')?.addEventListener('click', () => step(-1));
		section.querySelector('[data-next]')?.addEventListener('click', () => step(1));
	}
</script>

<style>
	.gallery {
		padding-left: 0;
		padding-right: 0;
		overflow: hidden;
	}
	.head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 32px;
		max-width: 1180px;
		margin: 0 auto;
		padding: 0 24px;
	}
	.head .tm-display {
		font-size: clamp(40px, 5.6vw, 76px);
	}
	.text {
		max-width: 620px;
		margin: 20px 0 0;
		font-size: clamp(17px, 1.6vw, 21px);
		line-height: 1.5;
		color: var(--tm-slate);
	}
	.arrows {
		display: flex;
		gap: 10px;
	}
	.arrows button {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		color: var(--tm-ink);
		background: var(--tm-mist);
		transition: background-color 0.2s ease;
	}
	.arrows button:hover {
		background: #e8e8ed;
	}
	.row {
		display: flex;
		gap: 20px;
		margin: 56px 0 0;
		padding: 8px max(24px, calc((100vw - 1180px) / 2 + 24px)) 24px;
		list-style: none;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-padding: 0 max(24px, calc((100vw - 1180px) / 2 + 24px));
		scrollbar-width: none;
	}
	.row::-webkit-scrollbar {
		display: none;
	}
	.row li {
		flex: 0 0 auto;
		scroll-snap-align: start;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 12px;
		width: min(340px, 78vw);
		height: 440px;
		padding: 30px;
		border-radius: 28px;
		color: #fff;
		background:
			radial-gradient(120% 70% at 100% 0%, rgba(255, 255, 255, 0.28), transparent 60%),
			linear-gradient(160deg, color-mix(in srgb, var(--c) 78%, #fff), color-mix(in srgb, var(--c) 82%, #000));
		transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	.card:hover {
		transform: scale(1.02);
	}
	.category {
		font-size: 14px;
		font-weight: 600;
		opacity: 0.85;
	}
	.card b {
		font-size: 30px;
		font-weight: 800;
		line-height: 1.08;
		letter-spacing: -0.035em;
	}
	.summary {
		font-size: 16px;
		line-height: 1.5;
		opacity: 0.92;
	}
	.foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-top: auto;
		font-size: 14px;
	}
	.counts {
		opacity: 0.8;
	}
	.use {
		display: inline-flex;
		align-items: center;
		padding: 8px 16px;
		border-radius: 999px;
		font-weight: 600;
		color: var(--tm-ink);
		background: #fff;
	}
	.card.ask {
		color: var(--tm-night-ink);
		background:
			radial-gradient(90% 60% at 100% 0%, rgba(167, 139, 250, 0.35), transparent 65%),
			radial-gradient(80% 60% at 0% 100%, rgba(52, 211, 153, 0.3), transparent 65%),
			#0c0c0f;
	}
	.spark {
		display: grid;
		place-items: center;
		width: 54px;
		height: 54px;
		margin-bottom: 8px;
		border-radius: 16px;
		color: #c4b5fd;
		background: rgba(255, 255, 255, 0.08);
	}

	@media (max-width: 700px) {
		.head {
			flex-direction: column;
			align-items: flex-start;
		}
		.arrows {
			display: none;
		}
	}
</style>
