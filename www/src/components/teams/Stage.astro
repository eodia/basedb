				<span class="muted">· {s.base}</span>
				<span class="muted end" set:html={icon('close', 15)} />
			</p>
			<div class="c-body">
				<p class="ask">{s.copilot.question}</p>
				<p class="thinking"><span class="spin" set:html={icon('loader', 14, 2)} />{s.copilot.thinking}</p>
				<p class="answer">{s.copilot.answer}</p>
				<div class="action">
					<p class="a-head"><span set:html={icon('filter', 14)} />{s.copilot.card}</p>
					<code>{s.copilot.filter}</code>
					<span class="stack">
						<span class="apply">{s.copilot.apply}</span>
						<span class="applied"><span set:html={icon('check', 14, 2.4)} />{s.copilot.applied}</span>
					</span>
				</div>
			</div>
			<div class="c-input">
				<span>{s.copilot.placeholder}</span>
				<i set:html={icon('up', 15, 2.4)} />
			</div>
		</aside>
	</div>
</div>

<script>
	const frame = document.querySelector<HTMLElement>('[data-frame]');
	if (frame !== null) {
		// Drawn at 1080 × 600, shown at the width it is given — never under its smallest
		// scale: below it, the window is cut on the right rather than shrunk to nothing.
		const min = Number(frame.dataset.min ?? 0.5);
		const fit = () => frame.style.setProperty('--k', String(Math.min(1, Math.max(min, frame.clientWidth / 1080))));
		fit();
		new ResizeObserver(fit).observe(frame);
	}
</script>

