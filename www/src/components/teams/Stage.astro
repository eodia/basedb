---
/**
 * The window of the home page's story: a team's client follow-up in basedb, drawn as the
 * application draws it — its sidebar, its bar, its tabs and toolbar, the grid with its
 * typed columns — and the same seven rows shown five ways: the table; the table again,
 * with the Copilot asked who to call back, whose filter it applies; a kanban; a calendar;
 * the bars of a dashboard.
 *
 * Every view's geometry is worked out here, at build time, and written on each row as
 * custom properties (`--grid-x`, `--kanban-y`…); the `data-view` its parent writes picks
 * the set, and CSS moves the rows from one to the other. Without JavaScript, the table.
 * Drawn at a fixed size, 1080 × 600, and scaled to the width it is given.
 */
import { type Locale, fill, i18n } from '../../i18n';

interface Props {
	locale: Locale;
	/** The smallest scale: under it, the window is cut on the right rather than shrunk. */
	minScale?: number;
}

const { locale, minScale = 0.5 } = Astro.props;
const { t, lang } = i18n(locale);
const s = t.teams.stage;

type Status = keyof typeof s.statuses;
type View = 'grid' | 'copilot' | 'kanban' | 'calendar' | 'dashboard';
const VIEWS: View[] = ['grid', 'copilot', 'kanban', 'calendar', 'dashboard'];

const COLORS: Record<Status, string> = {
	contact: '#94a3b8',
	meeting: '#3b82f6',
	quote: '#f59e0b',
	signed: '#10b981',
};
const ORDER: Status[] = ['contact', 'meeting', 'quote', 'signed'];

const PEOPLE = {
	lea: { name: 'Léa', color: '#ec4899' },
	hugo: { name: 'Hugo', color: '#3b82f6' },
	camille: { name: 'Camille', color: '#8b5cf6' },
} as const;
type Person = keyof typeof PEOPLE;

/** What each client is, in the table's order; `cover`: the two colours of its card's picture. */
const FACTS: Array<{ status: Status; owner: Person; amount: number; day: number; cover: [string, string] }> = [
	{ status: 'signed', owner: 'lea', amount: 4200, day: 2, cover: ['#fcd9a8', '#e59f5b'] },
	{ status: 'quote', owner: 'hugo', amount: 12500, day: 6, cover: ['#b8e3dc', '#2a9d8f'] },
	{ status: 'meeting', owner: 'lea', amount: 6400, day: 8, cover: ['#c7d2fe', '#4f6bed'] },
	{ status: 'contact', owner: 'camille', amount: 2100, day: 20, cover: ['#fecdd3', '#e2445c'] },
	{ status: 'quote', owner: 'camille', amount: 7500, day: 13, cover: ['#f3ead8', '#2f4a3a'] },
	{ status: 'signed', owner: 'hugo', amount: 22000, day: 15, cover: ['#fde68a', '#ea580c'] },
	{ status: 'meeting', owner: 'lea', amount: 9800, day: 22, cover: ['#ddd6fe', '#7c3aed'] },
];
/** Who the Copilot finds to call back: a quote waiting, or a meeting to prepare. */
const matches = (status: Status) => status === 'quote' || status === 'meeting';

// ── Geometry, in the canvas's pixels: the area under the toolbar, 880 × 442, whose top
// left corner is at (200, 158) in the window ─────────────────────────────────────────────
const W = 880;
const H = 442;
const TOP = 158;
const HEAD = 36;
const ROW = 40;
const LANE = (W - 28 - 36) / 4;
const CARD = 150;
const CELL_W = W / 7;
const CAL_TOP = 72;
const CELL_H = (H - CAL_TOP) / 5;
// October 2026 begins on a Thursday: the fourth column of a week from Monday.
const FIRST = 3;
const TODAY = 6;
/** The dashboard's chart card, in the window: its top, and its axis. */
const CHART_TOP = 312;
const BASELINE = 548 - TOP;
const BAR_MAX = 176;
const MAX = Math.max(...FACTS.map((f) => f.amount));

const money = (n: number, compact = false) =>
	new Intl.NumberFormat(lang, {
		style: 'currency',
		currency: 'EUR',
		...(compact ? { notation: 'compact', maximumFractionDigits: 1 } : { minimumFractionDigits: 2 }),
	}).format(n);
const dateOf = (d: number) =>
	new Intl.DateTimeFormat(lang, { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }).format(
		new Date(Date.UTC(2026, 9, d)),
	);
const monthTitle = new Intl.DateTimeFormat(lang, { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
	new Date(Date.UTC(2026, 9, 1)),
);
const weekdays = Array.from({ length: 7 }, (_, i) =>
	new Intl.DateTimeFormat(lang, { weekday: 'short', timeZone: 'UTC' }).format(new Date(Date.UTC(2026, 8, 28 + i))),
);
const percent = new Intl.NumberFormat(lang, { style: 'percent', maximumFractionDigits: 0 });

const byAmount = FACTS.map((f, i) => ({ i, amount: f.amount }))
	.sort((a, b) => b.amount - a.amount)
	.map((r) => r.i);
const found = FACTS.map((f, i) => ({ i, hit: matches(f.status) }))
	.filter((r) => r.hit)
	.map((r) => r.i);

const rows = s.clients.map((name, i) => {
	const fact = FACTS[i]!;
	const lane = ORDER.indexOf(fact.status);
	const inLane = FACTS.slice(0, i).filter((f) => f.status === fact.status).length;
	const cell = FIRST + fact.day - 1;
	const bar = byAmount.indexOf(i);
	const barH = Math.max(8, Math.round((fact.amount / MAX) * BAR_MAX));
	const hit = matches(fact.status);
	const grid: [number, number, number, number] = [0, HEAD + i * ROW, W, ROW];
	const geometry: Record<View, [number, number, number, number]> = {
		grid,
		copilot: hit ? [0, HEAD + found.indexOf(i) * ROW, W, ROW] : grid,
		kanban: [14 + lane * (LANE + 12) + 8, 58 + inLane * (CARD + 10), LANE - 16, CARD],
		calendar: [(cell % 7) * CELL_W + 5, CAL_TOP + Math.floor(cell / 7) * CELL_H + 28, CELL_W - 10, 22],
		dashboard: [226 + bar * 58, BASELINE - barH, 34, barH],
	};
	const vars = [`--i:${i}`, `--c:${COLORS[fact.status]}`, `--c1:${fact.cover[0]}`, `--c2:${fact.cover[1]}`];
	for (const view of VIEWS) {
		const [x, y, w, h] = geometry[view];
		vars.push(`--${view}-x:${x}px`, `--${view}-y:${y}px`, `--${view}-w:${w}px`, `--${view}-h:${h}px`);
	}
	const person = PEOPLE[fact.owner];
	return {
		name,
		...fact,
		hit,
		person,
		date: dateOf(fact.day),
		amountText: money(fact.amount),
		compact: money(fact.amount, true),
		style: vars.join(';'),
		// The card's description: its text, the row's values cited in bold.
		card: s.card
			.split(/(\{owner\}|\{date\})/)
			.map((part) =>
				part === '{owner}' ? { bold: person.name } : part === '{date}' ? { bold: dateOf(fact.day) } : { text: part },
			),
	};
});

const signed = FACTS.filter((f) => f.status === 'signed');
const kpis = [
	{ label: s.kpis.signed, value: money(signed.reduce((n, f) => n + f.amount, 0)) },
	{ label: s.kpis.pending, value: money(FACTS.filter((f) => f.status === 'quote').reduce((n, f) => n + f.amount, 0)) },
	{ label: s.kpis.rate, value: percent.format(signed.length / FACTS.length) },
];
const lanes = ORDER.map((status, i) => ({
	status,
	label: s.statuses[status],
	count: FACTS.filter((f) => f.status === status).length,
	x: 14 + i * (LANE + 12),
}));
const days = Array.from({ length: 35 }, (_, i) => {
	const date = new Date(Date.UTC(2026, 8, 28 + i));
	return {
		n: date.getUTCDate(),
		out: date.getUTCMonth() !== 9,
		today: date.getUTCMonth() === 9 && date.getUTCDate() === TODAY,
		x: (i % 7) * CELL_W,
		y: CAL_TOP + Math.floor(i / 7) * CELL_H,
	};
});
/** The chart's lines, placed in its card. */
const rules = [5000, 10000, 15000, 20000].map((v) => ({
	top: BASELINE - (v / MAX) * BAR_MAX + TOP - CHART_TOP,
	label: money(v, true),
}));
const axisTop = BASELINE + TOP - CHART_TOP;
// The ring of the dashboard: the clients by stage.
let turned = 0;
const ring = ORDER.map((status) => {
	const share = (FACTS.filter((f) => f.status === status).length / FACTS.length) * 100;
	const offset = -turned;
	turned += share;
	return { status, share, offset, color: COLORS[status], label: s.statuses[status] };
});

/** Line icons of the application's own vocabulary, 24 × 24. */
const I = {
	panel: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18"/>',
	table: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/>',
	kanban: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M15 3v18"/>',
	calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
	dashboard:
		'<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>',
	zap: '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
	sparkles: '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 3v4M17 5h4"/>',
	bell: '<path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/>',
	search: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
	filter: '<path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/>',
	eye: '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>',
	layers: '<path d="m12 2 10 5-10 5L2 7l10-5z"/><path d="m2 17 10 5 10-5M2 12l10 5 10-5"/>',
	palette:
		'<circle cx="13.5" cy="6.5" r="1"/><circle cx="17.5" cy="10.5" r="1"/><circle cx="8.5" cy="7.5" r="1"/><circle cx="6.5" cy="12.5" r="1"/><path d="M12 2a10 10 0 0 0 0 20c.9 0 1.6-.7 1.6-1.7 0-.4-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.9.7-1.7 1.6-1.7H16a6 6 0 0 0 6-6C22 6 17.5 2 12 2z"/>',
	sort: '<path d="m3 16 4 4 4-4M7 20V4M21 8l-4-4-4 4M17 4v16"/>',
	sliders: '<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
	plus: '<path d="M12 5v14M5 12h14"/>',
	chevron: '<path d="m6 9 6 6 6-6"/>',
	chevronsV: '<path d="m7 15 5 5 5-5M7 9l5-5 5 5"/>',
	left: '<path d="m15 18-6-6 6-6"/>',
	right: '<path d="m9 18 6-6-6-6"/>',
	db: '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>',
	building:
		'<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"/>',
	contact: '<circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/>',
	receipt: '<path d="M4 2v20l3-2 3 2 3-2 3 2 3-2 3 2V2l-3 2-3-2-3 2-3-2-3 2z"/><path d="M8 8h8M8 12h8M8 16h5"/>',
	text: '<path d="M4 7V4h16v3M9 20h6M12 4v16"/>',
	select: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5L16 9.5"/>',
	user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
	money: '<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/>',
	grip: '<circle cx="9" cy="6" r="1"/><circle cx="15" cy="6" r="1"/><circle cx="9" cy="12" r="1"/><circle cx="15" cy="12" r="1"/><circle cx="9" cy="18" r="1"/><circle cx="15" cy="18" r="1"/>',
	refresh: '<path d="M23 4v6h-6M1 20v-6h6"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>',
	share: '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/>',
	pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>',
	compass: '<circle cx="12" cy="12" r="10"/><path d="m16.24 7.76-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z"/>',
	chart: '<path d="M3 3v18h18"/><path d="M8 17v-5M13 17V8M18 17v-9"/>',
	close: '<path d="M18 6 6 18M6 6l12 12"/>',
	up: '<path d="M12 19V5M5 12l7-7 7 7"/>',
	check: '<path d="M20 6 9 17l-5-5"/>',
	loader: '<path d="M21 12a9 9 0 1 1-6.22-8.56"/>',
} as const;
const icon = (name: keyof typeof I, size = 15, width = 1.8) =>
	`<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${I[name]}</svg>`;
const TABLE_ICONS = [
	{ name: 'building', color: '#3b82f6' },
	{ name: 'contact', color: '#8b5cf6' },
	{ name: 'receipt', color: '#f59e0b' },
] as const;
const tableIcon = (i: number, size = 15) => {
	const t = TABLE_ICONS[i % TABLE_ICONS.length]!;
	return `<span style="display:inline-flex;color:${t.color}">${icon(t.name, size)}</span>`;
};
const columns = [
	{ key: 'name', icon: 'text', label: s.columns.name },
	{ key: 'status', icon: 'select', label: s.columns.status },
	{ key: 'owner', icon: 'user', label: s.columns.owner },
	{ key: 'amount', icon: 'money', label: s.columns.amount },
	{ key: 'next', icon: 'calendar', label: s.columns.next },
] as const;
/** The views that show the table, its tabs and its toolbar. */
const TABLE_VIEWS = 'grid copilot kanban calendar';
---

<div class="frame" data-frame data-min={minScale}>
	<div class="stage" data-stage data-view="grid" role="img" aria-label={s.aria}>
		<!-- The window -->
		<div class="chrome">
			<span class="dots"><i></i><i></i><i></i></span>
			<span class="url">{t.hero.demo.url}</span>
		</div>

		<!-- The sidebar, as the application has it -->
		<aside class="side">
			<div class="project">
				<span class="mark" set:html={icon('dashboard', 15, 2)} />
				<span class="who">
					<b>{s.project}</b>
					<small>{s.projectMeta}</small>
				</span>
				<span class="muted" set:html={icon('chevronsV', 14)} />
			</div>
			<div class="navfilter">
				<span class="field"><span class="muted" set:html={icon('search', 13)} /><span class="hint">{s.filterNav}</span></span>
				<span class="muted" set:html={icon('plus', 15)} />
			</div>
			<div class="tree">
				<p class="base">
					<span class="muted" set:html={icon('chevron', 13)} />
					<span class="muted" set:html={icon('db', 15)} />
					{s.base}
				</p>
				{
					s.tables.map((table, i) => (
						<p class:list={['table', { first: i === 0 }]}>
							<Fragment set:html={tableIcon(i)} />
							{table}
						</p>
					))
				}
				<p class="base closed">
					<span class="muted" set:html={icon('right', 13)} />
					<span class="muted" set:html={icon('db', 15)} />
					{s.otherBase}
				</p>
			</div>
			<div class="screens">
				<p class="label">{s.baseSection}</p>
				<p class="screen dash"><span class="muted" set:html={icon('dashboard', 15)} />{s.screens[0]}</p>
				<p class="screen"><span class="muted" set:html={icon('zap', 15)} />{s.screens[1]}</p>
			</div>
			<div class="me">
				<i class="face" style={`background:${PEOPLE.lea.color}`}>LM</i>
				<b>{s.user}</b>
				<span class="muted" set:html={icon('chevronsV', 14)} />
			</div>
		</aside>

		<!-- The bar -->
		<header class="top">
			<span class="muted" set:html={icon('panel', 16)} />
			<span class="crumbs">
				<span class="muted">{s.base}</span>
				<span class="muted">/</span>
				<span class="stack">
					<b data-show={TABLE_VIEWS}>{s.tables[0]}</b>
					<b data-show="dashboard">{s.screens[0]}</b>
				</span>
			</span>
			<span class="faces">{Object.values(PEOPLE).map((p) => <i style={`background:${p.color}`}>{p.name.charAt(0)}</i>)}</span>
			<span class="bell"><span set:html={icon('bell', 16)} /><em>2</em></span>
			<span class="copilot-button"><span set:html={icon('sparkles', 15)} />Copilot</span>
		</header>

		<!-- The table's tabs and its toolbar -->
		<div class="tabs" data-show={TABLE_VIEWS}>
			{
				s.tables.map((table, i) => (
					<span class:list={['tab', { on: i === 0 }]}>
						<Fragment set:html={tableIcon(i, 14)} />
						{table}
					</span>
				))
			}
			<span class="tab plus" set:html={icon('plus', 15)} />
		</div>
		<div class="toolbar" data-show={TABLE_VIEWS}>
			<span class="switch">
				<span class="stack">
					<span class="viewname" data-show="grid copilot"><span class="green" set:html={icon('table', 15)} />{s.views.grid}</span>
					<span class="viewname" data-show="kanban"><span class="green" set:html={icon('kanban', 15)} />{s.views.kanban}</span>
					<span class="viewname" data-show="calendar"><span class="green" set:html={icon('calendar', 15)} />{s.views.calendar}</span>
				</span>
				<span class="muted" set:html={icon('chevron', 13)} />
			</span>
			<span class="stack">
				<span class="toolset" data-show="grid copilot">
					<span class="tool filterbox">
						<span class="plain"><span set:html={icon('filter', 15)} />{s.toolbar.filter}</span>
						<span class="filtered"><span set:html={icon('filter', 15)} />{fill(s.copilot.filtered, { n: found.length })}</span>
					</span>
					<span class="tool"><span set:html={icon('eye', 15)} />{s.toolbar.columns}</span>
					<span class="tool"><span set:html={icon('layers', 15)} />{s.toolbar.group}</span>
					<span class="tool"><span set:html={icon('palette', 15)} />{s.toolbar.colors}</span>
				</span>
				<span class="toolset" data-show="kanban calendar">
					<span class="tool"><span set:html={icon('filter', 15)} />{s.toolbar.filter}</span>
					<span class="tool"><span set:html={icon('sort', 15)} />{s.toolbar.sort}</span>
					<span class="tool"><span set:html={icon('sliders', 15)} />{s.toolbar.configure}</span>
				</span>
			</span>
			<span class="search"><span set:html={icon('search', 14)} />{s.search}</span>
			<span class="add"><span set:html={icon('plus', 15, 2.2)} />{s.add}</span>
		</div>

		<!-- The dashboard's screen: the list of dashboards, and the one open -->
		<div class="board" data-show="dashboard">
			<div class="boards">
				<p class="label">{s.dashboards}<span set:html={icon('plus', 14)} /></p>
				<p class="item on"><span class="muted" set:html={icon('dashboard', 15)} />{s.dashboard}</p>
				<p class="label">{s.questions}<span set:html={icon('plus', 14)} /></p>
				<p class="item"><span class="muted" set:html={icon('chart', 15)} />{s.chart}</p>
				<p class="explore"><span set:html={icon('compass', 15)} />{s.explore}</p>
			</div>
			<div class="page">
				<div class="head">
					<div>
						<b>{s.dashboard}</b>
						<small>{s.dashboardText}</small>
					</div>
					<span class="actions">
						<span class="muted" set:html={icon('refresh', 15)} />
						<span class="btn"><span set:html={icon('share', 14)} />{s.share}</span>
						<span class="btn"><span set:html={icon('pen', 14)} />{s.edit}</span>
					</span>
				</div>
				<div class="dtabs">
					{s.dashboardTabs.map((tab, i) => <span class:list={{ on: i === 0 }}>{tab}</span>)}
				</div>
				<div class="chips">
					<span class="chip on">
						<span set:html={icon('calendar', 13)} />
						<em>{s.period}</em>
						{s.thisYear}
						<span class="muted" set:html={icon('close', 11)} />
					</span>
					<span class="chip">
						<span set:html={icon('filter', 13)} />
						{s.columns.status}
						<span class="muted" set:html={icon('chevron', 11)} />
					</span>
				</div>
				<div class="kpis">
					{
						kpis.map((k) => (
							<div class="kpi">
								<span>{k.label}</span>
								<b>{k.value}</b>
							</div>
						))
					}
				</div>
				<div class="card chart">
					<span class="title">{s.chart}</span>
					{
						rules.map((r) => (
							<span class="rule" style={`top:${r.top}px`}>
								<em>{r.label}</em>
							</span>
						))
					}
					<span class="axis" style={`top:${axisTop}px`} />
				</div>
				<div class="card donut">
					<span class="title">{s.byStage}</span>
					<svg viewBox="0 0 42 42" aria-hidden="true">
						<circle cx="21" cy="21" r="15.915" class="hole" />
						{ring.map((r) => <circle cx="21" cy="21" r="15.915" class="seg" stroke={r.color} style={`--share:${r.share};--offset:${r.offset}`} />)}
					</svg>
					<ul>
						{ring.map((r) => <li style={`--c:${r.color}`}>{r.label}</li>)}
					</ul>
				</div>
			</div>
		</div>

		<!-- The area under the toolbar, where the rows are -->
		<div class="canvas">
			<div class="layer grid" data-show="grid copilot">
				<div class="ghead">
					<span class="c-check"><i class="box"></i></span>
					<span class="c-num">#</span>
					{
						columns.map((c) => (
							<span class={`c-${c.key}`}>
								<span class="grip" set:html={icon('grip', 12)} />
								<span class="type" set:html={icon(c.icon, 14)} />
								{c.label}
								<span class="sort" set:html={icon('chevronsV', 12)} />
							</span>
						))
					}
				</div>
				<div class="gadd">
					<span class="c-check" set:html={icon('plus', 15)} />
					<span class="c-name">{s.addRow}</span>
				</div>
				<div class="gfoot">
					<span>{s.perPage}</span>
					<span class="select">100<span set:html={icon('chevron', 11)} /></span>
					<span class="stack count">
						<span data-show="grid">1–7</span>
						<span class="later" data-show="copilot">1–{found.length}</span>
					</span>
				</div>
			</div>

			<div class="layer kanban" data-show="kanban">
				{
					lanes.map((lane) => (
						<div class="lane" style={`left:${lane.x}px;width:${LANE}px;--c:${COLORS[lane.status]}`}>
							<p class="lane-head">
								<i class="chip-s">{lane.label}</i>
								<em>{lane.count}</em>
								<span class="muted" set:html={icon('plus', 14)} />
							</p>
							<p class="lane-add">
								<span set:html={icon('plus', 13)} />
								{s.addCard}
							</p>
						</div>
					))
				}
			</div>

			<div class="layer calendar" data-show="calendar">
				<div class="calbar">
					<span class="today">{s.today}</span>
					<span class="muted" set:html={icon('left', 16)} />
					<span class="muted" set:html={icon('right', 16)} />
					<b>{monthTitle}</b>
					<span class="modes"><i class="on">{s.month}</i><i>{s.week}</i></span>
				</div>
				{weekdays.map((d, i) => <span class="wd" style={`left:${i * CELL_W}px;width:${CELL_W}px`}>{d}</span>)}
				{
					days.map((d) => (
						<span class:list={['day', { out: d.out }]} style={`left:${d.x}px;top:${d.y}px;width:${CELL_W}px;height:${CELL_H}px`}>
							<i class:list={{ today: d.today }}>{d.n}</i>
						</span>
					))
				}
			</div>

			<!-- The clients: one element each, whatever the view -->
			{
				rows.map((r, i) => (
					<div class="rec" style={r.style} data-match={r.hit ? '1' : '0'}>
						<div class="r-row" data-show="grid copilot">
							<span class="c-check">
								<i class="box" />
							</span>
							<span class="c-num">{i + 1}</span>
							<span class="c-name">{r.name}</span>
							<span class="c-status">
								<i class="chip-s">{s.statuses[r.status]}</i>
							</span>
							<span class="c-owner">
								<i class="face" style={`background:${r.person.color}`}>
									{r.person.name.charAt(0)}
								</i>
								{r.person.name}
							</span>
							<span class="c-amount">{r.amountText}</span>
							<span class="c-next">{r.date}</span>
						</div>
						<div class="r-card" data-show="kanban">
							<span class="cover" />
							<span class="body">
								<b>{r.name}</b>
								<span class="desc">{r.card.map((part) => ('bold' in part ? <strong>{part.bold}</strong> : part.text))}</span>
								<span class="field">
									<span set:html={icon('money', 13)} />
									{r.amountText}
								</span>
							</span>
						</div>
						<div class="r-chip" data-show="calendar">
							{r.name}
						</div>
						<div class="r-bar" data-show="dashboard">
							<span class="value">{r.compact}</span>
							<span class="name">{r.name}</span>
						</div>
					</div>
				))
			}
		</div>

		<!-- The Copilot, asked who to call back -->
		<aside class="copilot" data-show="copilot">
			<p class="c-head">
				<span class="green" set:html={icon('sparkles', 16)} />
