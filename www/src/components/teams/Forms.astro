---
/**
 * The same three questions asked two ways on a phone — the questionnaire, one per screen,
 * and the form, all on one page — on the page of the link, as basedb draws it: numbered
 * questions on a line, the choices as cards with their keys (A, B, C) that go on by
 * themselves once taken, « OK » or Entrée, and the end celebrated with confetti. The phone
 * answers while the section is on screen, in a loop that alternates the two ways; each
 * answer sent lands as a new row of the table beside it, and the link counts one more.
 * The switch over the phone picks a way, and the loop then keeps to it. Asked for less
 * motion, the scene shows the answers given and their row arrived.
 *
 * The phone is drawn at 320 × 640, the table at 660 × 500; each is scaled to its column.
 */
import { type Locale, i18n } from '../../i18n';
import Icon from '../landing/Icon.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, lang, href, number, plural } = i18n(locale);
const f = t.teams.forms;
const d = f.demo;
const stage = t.teams.stage;

const money = (n: number) =>
	new Intl.NumberFormat(lang, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);

type Stage = keyof typeof d.stages;
const NEED_COLORS = ['#3b82f6', '#a855f7', '#f59e0b'];
const STAGE_COLORS: Record<Stage, string> = { new: '#22c55e', called: '#0ea5e9', quote: '#f97316' };
const FACTS: Array<{ need: number; budget: number; stage: Stage }> = [
	{ need: 0, budget: 3500, stage: 'quote' },
	{ need: 2, budget: 12000, stage: 'called' },
	{ need: 1, budget: 2800, stage: 'quote' },
	{ need: 0, budget: 9500, stage: 'called' },
];
const rows = d.rows.map((org, i) => {
	const fact = FACTS[i] ?? FACTS[0]!;
	return { org, need: fact.need, budget: money(fact.budget), stage: fact.stage };
});

/** What the person answers: a name, the second option, a budget. */
const CHOSEN = 1;
const answer = { org: d.org.answer, need: d.need.options[CHOSEN] ?? '', budget: money(8000) };
const ANSWERS = 23;
const HOST = 'basedb.example.com';
const LINK = `https://${HOST}/f/t4hhyFEQn9vN6rohy7h8`;
/** The keys of the choices, as the survey shows them. */
const KEYS = ['A', 'B', 'C', 'D', 'E', 'F'];
/** Confetti from the check: where each piece rises to, how it turns, its colour, its delay. */
const CONFETTI_COLORS = ['var(--bd-primary)', '#f59e0b', '#3b82f6', '#ec4899', '#a855f7', '#22c55e'];
const confetti = Array.from({ length: 28 }, (_, i) => {
	const angle = -Math.PI / 2 + ((i % 14) / 13 - 0.5) * Math.PI * 1.25;
	const reach = 70 + ((i * 37) % 60);
	return {
		x: Math.round(Math.cos(angle) * reach),
		y: Math.round(Math.sin(angle) * reach),
		r: (i * 67) % 360,
		c: CONFETTI_COLORS[i % CONFETTI_COLORS.length],
		d: ((i % 7) * 0.035).toFixed(3),
		round: i % 4 === 0,
	};
});
---

<section class="tm-section mist forms" data-forms>
	<div class="tm-head tm-rise">
		<p class="tm-kicker">{f.eyebrow}</p>
		<h2 class="tm-display">
			<span>{f.title}</span>
			<span class="tm-grad">{f.titleAccent}</span>
		</h2>
		<p class="tm-lede">{f.text}</p>
	</div>

	<div class="switch tm-rise" role="group" aria-label={f.modes.label} data-switch>
		<button type="button" data-mode="survey" aria-pressed="true">{f.modes.survey}</button>
		<button type="button" data-mode="form" aria-pressed="false">{f.modes.form}</button>
	</div>

	<div class="scene" data-scene data-mode="survey" aria-hidden="true">
		<div class="phone-frame" data-phone-frame>
			<div class="phone">
				<div class="screen">
					<div class="status">
						<b>9:41</b>
						<span class="island"></span>
						<span class="signal"><i></i><i></i><i></i><i></i></span>
					</div>
					<div class="address"><Icon name="lock" size={11} stroke={2.2} />{HOST}</div>

					<div class="page" data-page>
						<div class="card survey" data-way="survey">
							<div class="progress"><i data-progress></i></div>
							<div class="screens">
								<div class="sv on" data-screen="welcome">
									<h3>{d.title}</h3>
									<p class="desc">{d.description}</p>
									<span class="go">
										<span class="btn lg" data-press>{d.start}<Icon name="arrowRight" size={16} /></span>
										<span class="hint">{d.hint}<Icon name="cornerDownLeft" size={12} /></span>
									</span>
									<p class="small"><Icon name="clock" size={13} />{d.count}</p>
								</div>
								<div class="sv" data-screen="0">
									<div class="q">
										<p class="label big"><span class="k">{number(1)}<Icon name="arrowRight" size={12} stroke={2.4} /></span>{d.org.label}<i>*</i></p>
										<span class="input line" data-field><span data-typed={answer.org}></span></span>
									</div>
									<div class="nav">
										<span class="btn" data-press><Icon name="tick" size={14} stroke={2.6} />{d.ok}</span>
										<span class="hint">{d.hint}<Icon name="cornerDownLeft" size={12} /></span>
									</div>
								</div>
								<div class="sv" data-screen="1">
									<div class="q">
										<p class="label big"><span class="k">{number(2)}<Icon name="arrowRight" size={12} stroke={2.4} /></span>{d.need.label}<i>*</i></p>
										<span class="choices" data-field data-select={CHOSEN}>
											{
												d.need.options.map((o, i) => (
													<span class="choice" data-opt={i}>
														<b>{KEYS[i]}</b>
														{o}
														<Icon name="tick" size={14} stroke={2.6} />
													</span>
												))
											}
										</span>
									</div>
								</div>
								<div class="sv" data-screen="2">
									<div class="q">
										<p class="label big"><span class="k">{number(3)}<Icon name="arrowRight" size={12} stroke={2.4} /></span>{d.budget.label}</p>
										<p class="help">{d.budget.help}</p>
										<span class="input line" data-field><span data-typed={answer.budget}></span></span>
									</div>
									<div class="nav">
										<span class="btn" data-press><Icon name="send" size={14} />{d.submit}</span>
										<span class="hint">{d.hint}<Icon name="cornerDownLeft" size={12} /></span>
									</div>
								</div>
							</div>
							<span class="arrows"><i><Icon name="chevronUp" size={14} stroke={2.2} /></i><i><Icon name="chevronDown" size={14} stroke={2.2} /></i></span>
						</div>

						<div class="card form" data-way="form">
							<header>
								<h3>{d.title}</h3>
								<p class="desc">{d.description}</p>
							</header>
							<div class="qs">
								<div class="q">
									<p class="label">{d.org.label}<i>*</i></p>
									<span class="input" data-field><span data-typed={answer.org}></span></span>
								</div>
								<div class="q">
									<p class="label">{d.need.label}<i>*</i></p>
									<span class="choices small" data-field data-select={CHOSEN}>
										{
											d.need.options.map((o, i) => (
												<span class="choice" data-opt={i}>
													{o}
													<Icon name="tick" size={13} stroke={2.6} />
												</span>
											))
										}
									</span>
								</div>
								<div class="q">
									<p class="label">{d.budget.label}</p>
									<p class="help">{d.budget.help}</p>
									<span class="input" data-field><span data-typed={answer.budget}></span></span>
								</div>
							</div>
							<footer>
								<span class="btn" data-press><Icon name="send" size={14} />{d.submit}</span>
							</footer>
						</div>

						<div class="card thanks">
							<span class="burst">
								{
									confetti.map((c) => (
										<i
											class={c.round ? 'round' : undefined}
											style={`--x:${c.x}px;--y:${c.y}px;--r:${c.r}deg;--c:${c.c};--d:${c.d}s`}
										/>
									))
								}
							</span>
							<span class="tick"><Icon name="tick" size={30} stroke={3} /></span>
							<p class="sent">{d.sent}</p>
							<p>{d.thanks}</p>
						</div>
					</div>
					<p class="powered">{d.poweredBy}</p>
				</div>
			</div>
		</div>

		<div class="desk-frame" data-desk-frame>
			<div class="desk">
				<div class="win">
					<div class="bar">
						<span class="dots"><i></i><i></i><i></i></span>
						<span class="path">{d.path}</span>
					</div>
					<div class="tools">
						<span class="pill"><Icon name="table" size={13} />{d.view}<Icon name="chevronDown" size={13} /></span>
						<span>{stage.toolbar.filter}</span>
						<span>{stage.toolbar.sort}</span>
						<span class="add"><Icon name="plus" size={13} stroke={2.2} />{stage.add}</span>
					</div>
					<div class="grid">
						<div class="row head">
							<span class="n">#</span>
							<span>{d.columns.org}</span>
							<span>{d.columns.need}</span>
							<span class="num">{d.columns.budget}</span>
							<span>{d.columns.stage}</span>
						</div>
						{
							rows.map((r, i) => (
								<div class="row">
									<span class="n">{number(i + 1)}</span>
									<span class="org">{r.org}</span>
									<span>
										<i class="chip" style={`--c:${NEED_COLORS[r.need]}`}>
											{d.need.options[r.need]}
										</i>
									</span>
									<span class="num">{r.budget}</span>
									<span>
										<i class="chip" style={`--c:${STAGE_COLORS[r.stage]}`}>
											{d.stages[r.stage]}
										</i>
									</span>
								</div>
							))
						}
						<div class="row fresh" data-fresh>
							<span class="n">{number(rows.length + 1)}</span>
							<span class="org">{answer.org}</span>
							<span>
								<i class="chip" style={`--c:${NEED_COLORS[CHOSEN]}`}>{answer.need}</i>
							</span>
							<span class="num">{answer.budget}</span>
							<span>
								<i class="chip" style={`--c:${STAGE_COLORS.new}`}>{d.stages.new}</i>
							</span>
						</div>
						<div class="row add-row"><Icon name="plus" size={13} />{stage.addRow}</div>
					</div>
				</div>

				<div class="share">
					<div class="top">
						<span class="badge">{d.open}</span>
						<span class="count" data-count data-next={plural(d.answers, ANSWERS + 1)}>
							{plural(d.answers, ANSWERS)}
						</span>
						<span class="active">{d.active}<i class="toggle"></i></span>
					</div>
					<div class="link">
						<span class="url">{LINK}</span>
						<span class="ib"><Icon name="copy" size={14} /></span>
						<span class="ib"><Icon name="external" size={14} /></span>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="tm-points">
		<div class="tm-rise">
			<span class="ic"><Icon name="form" size={22} /></span>
			<h3>{f.points.survey.title}</h3>
			<p>{f.points.survey.text}</p>
		</div>
		<div class="tm-rise">
			<span class="ic"><Icon name="globe" size={22} /></span>
			<h3>{f.points.access.title}</h3>
			<p>{f.points.access.text}</p>
		</div>
		<div class="tm-rise">
			<span class="ic"><Icon name="lock" size={22} /></span>
			<h3>{f.points.closed.title}</h3>
			<p>{f.points.closed.text}</p>
		</div>
	</div>
	<p class="more tm-rise"><a class="tm-link" href={href(f.link.href)}>{f.link.label}</a></p>
</section>

<script>
	import { fit, reducedMotion, whileVisible } from '../../lib/motion';

	type Way = 'survey' | 'form';
	type Sleep = (ms: number) => Promise<void>;

	const section = document.querySelector<HTMLElement>('[data-forms]');
	const scene = section?.querySelector<HTMLElement>('[data-scene]');
	if (section && scene) {
		fit(scene.querySelector<HTMLElement>('[data-phone-frame]')!, 320);
		fit(scene.querySelector<HTMLElement>('[data-desk-frame]')!, 660);
		const buttons = [...section.querySelectorAll<HTMLButtonElement>('[data-switch] button')];
		const page = scene.querySelector<HTMLElement>('[data-page]')!;
		const bar = scene.querySelector<HTMLElement>('[data-progress]')!;
		const fresh = scene.querySelector<HTMLElement>('[data-fresh]')!;
		const count = scene.querySelector<HTMLElement>('[data-count]')!;
		const counts = [count.textContent?.trim() ?? '', count.dataset.next ?? ''];
		const way = (w: Way) => scene.querySelector<HTMLElement>(`[data-way="${w}"]`)!;
		const screenOf = (name: string) => way('survey').querySelector<HTMLElement>(`[data-screen="${name}"]`)!;

		let current: Way = 'survey';
		/** Until the reader picks a way, the loop alternates them. */
		let picked = false;

		const setWay = (w: Way) => {
			current = w;
			scene.dataset.mode = w;
			for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.mode === w));
		};
		/** The questionnaire's screen, and its progress: none on the welcome, then one third a question. */
		const show = (name: string) => {
			for (const s of way('survey').querySelectorAll<HTMLElement>('[data-screen]')) {
				s.classList.toggle('on', s.dataset.screen === name);
			}
			const step = Number(name);
			bar.style.width = Number.isNaN(step) ? '0%' : `${(step * 100) / 3}%`;
		};
		const blur = () => {
			for (const el of scene.querySelectorAll<HTMLElement>('.focus')) el.classList.remove('focus');
		};
		const fill = (field: HTMLElement) => {
			const typed = field.querySelector<HTMLElement>('[data-typed]');
			if (typed) typed.textContent = typed.dataset.typed ?? '';
			field.querySelector<HTMLElement>(`[data-opt="${field.dataset.select}"]`)?.classList.add('chosen');
		};
		const reset = () => {
			page.classList.remove('sent');
			blur();
			for (const el of scene.querySelectorAll<HTMLElement>('.hover, .press, .chosen, .blink')) {
				el.classList.remove('hover', 'press', 'chosen', 'blink');
			}
			for (const typed of scene.querySelectorAll<HTMLElement>('[data-typed]')) typed.textContent = '';
			show('welcome');
			fresh.classList.remove('in');
			count.textContent = counts[0] ?? '';
			count.classList.remove('pop');
		};

		const press = async (el: HTMLElement, sleep: Sleep) => {
			el.classList.add('press');
			await sleep(200);
			el.classList.remove('press');
		};
		const type = async (field: HTMLElement, sleep: Sleep) => {
			const typed = field.querySelector<HTMLElement>('[data-typed]')!;
			const text = typed.dataset.typed ?? '';
			blur();
			field.classList.add('focus');
			await sleep(250);
			for (let i = 1; i <= text.length; i += 1) {
				typed.textContent = text.slice(0, i);
				await sleep(75);
			}
		};
		/** A choice taken: the card is pointed at, taken, and blinks once — as the survey does. */
		const choose = async (field: HTMLElement, sleep: Sleep) => {
			blur();
			await sleep(450);
			const option = field.querySelector<HTMLElement>(`[data-opt="${field.dataset.select}"]`)!;
			option.classList.add('hover');
			await sleep(420);
			option.classList.remove('hover');
			option.classList.add('chosen', 'blink');
			await sleep(450);
			option.classList.remove('blink');
		};

		const survey = async (sleep: Sleep) => {
			const next = (name: string) => screenOf(name).querySelector<HTMLElement>('[data-press]')!;
			const field = (name: string) => screenOf(name).querySelector<HTMLElement>('[data-field]')!;
			await sleep(1100);
			await press(next('welcome'), sleep);
			show('0');
			await sleep(650);
			await type(field('0'), sleep);
			await sleep(450);
			await press(next('0'), sleep);
			show('1');
			await sleep(650);
			// A single choice goes on by itself.
			await choose(field('1'), sleep);
			await sleep(150);
			show('2');
			await sleep(650);
			await type(field('2'), sleep);
			await sleep(600);
			await press(next('2'), sleep);
		};
		const form = async (sleep: Sleep) => {
			const fields = [...way('form').querySelectorAll<HTMLElement>('[data-field]')];
			await sleep(1100);
			await type(fields[0]!, sleep);
			await sleep(400);
			await choose(fields[1]!, sleep);
			await sleep(400);
			await type(fields[2]!, sleep);
			await sleep(600);
			blur();
			await press(way('form').querySelector<HTMLElement>('[data-press]')!, sleep);
		};
		/** The answer sent: the thanks on the phone, then its row in the table, live. */
		const arrive = () => {
			fresh.classList.add('in');
			count.textContent = counts[1] ?? '';
			count.classList.add('pop');
		};

		if (reducedMotion()) {
			// Still: every answer given, its row arrived; the switch changes the way shown.
			const still = () => {
				reset();
				for (const field of scene.querySelectorAll<HTMLElement>('[data-field]')) fill(field);
				show('2');
				arrive();
			};
			still();
			for (const b of buttons) {
				b.addEventListener('click', () => {
					setWay(b.dataset.mode === 'form' ? 'form' : 'survey');
					still();
				});
			}
		} else {
			reset();
			const replay = whileVisible(scene, async (sleep) => {
				for (;;) {
					reset();
					await (current === 'survey' ? survey(sleep) : form(sleep));
					await sleep(350);
					blur();
					page.classList.add('sent');
					await sleep(900);
					arrive();
					await sleep(3800);
					if (!picked) setWay(current === 'survey' ? 'form' : 'survey');
				}
			});
			for (const b of buttons) {
				b.addEventListener('click', () => {
					picked = true;
					setWay(b.dataset.mode === 'form' ? 'form' : 'survey');
					reset();
					replay();
				});
			}
		}
	}
</script>

<style>
	/* The switch between the two ways */
	.switch {
		display: flex;
		width: max-content;
		margin: 56px auto 0;
		padding: 4px;
		border-radius: 999px;
		background: #e6e6eb;
	}
	.switch button {
		padding: 9px 22px;
		border: 0;
		border-radius: 999px;
		font: inherit;
		font-size: 15px;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--tm-slate);
		background: transparent;
		cursor: pointer;
		transition:
			background-color 0.25s ease,
			color 0.25s ease,
			box-shadow 0.25s ease;
	}
	.switch button:hover {
		color: var(--tm-ink);
	}
	.switch button[aria-pressed='true'] {
		color: var(--tm-ink);
		background: #fff;
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.08),
			0 6px 16px -8px rgba(0, 0, 0, 0.2);
	}
	.switch button:focus-visible {
		outline: 2px solid var(--bd-primary);
		outline-offset: 2px;
	}

	.scene {
		--ink: #18181b;
		--soft: #71717a;
		--line: #e4e4e7;
		--tint: #f4f4f5;
		display: grid;
		grid-template-columns: 320px minmax(0, 660px);
		justify-content: center;
		align-items: center;
		gap: 72px;
		max-width: 1100px;
		margin: 44px auto 0;
		font-family: var(--bd-font-sans);
		color: var(--ink);
	}
	.scene :global(svg) {
		flex-shrink: 0;
	}

	/* The phone */
	.phone-frame {
		--k: 1;
		position: relative;
		width: 100%;
		max-width: 320px;
		height: calc(640px * var(--k));
	}
	.phone {
		position: absolute;
		top: 0;
		left: 0;
		width: 320px;
		height: 640px;
		padding: 11px;
		border-radius: 50px;
		background: #111113;
		box-shadow:
			inset 0 0 0 1.5px #3a3a3f,
			0 50px 90px -40px rgba(16, 24, 16, 0.55),
			0 20px 40px -24px rgba(16, 24, 16, 0.35);
		transform: scale(var(--k));
		transform-origin: 0 0;
	}
	.screen {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border-radius: 40px;
		font-size: 13px;
		background: #f7f7f8;
	}
	.status {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 44px;
		padding: 0 26px 0 30px;
		font-size: 14px;
	}
	.island {
		width: 92px;
		height: 27px;
		border-radius: 20px;
		background: #111113;
	}
	.signal {
		display: flex;
		align-items: flex-end;
		gap: 2px;
		height: 11px;
	}
	.signal i {
		width: 3px;
		border-radius: 1px;
		background: var(--ink);
	}
	.signal i:nth-child(1) {
		height: 4px;
	}
	.signal i:nth-child(2) {
		height: 6px;
	}
	.signal i:nth-child(3) {
		height: 8px;
	}
	.signal i:nth-child(4) {
		height: 11px;
	}
	.address {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 5px;
		height: 30px;
