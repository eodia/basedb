---
/**
 * An automation at work in the middle of the night, drawn as its editor draws it: the
 * automations of the base, the flow on its canvas, its runs beside. The scroll runs it —
 * a request has just arrived through the form; the condition picks the path of the big
 * projects and the other fades, each step lights up with its time and what it did, the
 * AI writes its answer — and the run lands in « Exécutions », step by step, until it ends
 * « Réussie ». Scrolling back undoes it. Asked for less motion, the run is shown done.
 *
 * Drawn at 1080 × 700 and scaled to the page; on a phone, the canvas alone, at 600 × 700.
 */
import { type Locale, fill, i18n } from '../../i18n';
import Icon from '../landing/Icon.astro';
import type { IconName } from '../landing/icons';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, href, number } = i18n(locale);
const a = t.teams.automate;
type StepKey = keyof typeof a.steps;

// The canvas, 590 wide: a column in the middle, one per path, cards of 250 × 50.
const MID = 295;
const LEFT = 160;
const RIGHT = 430;
const CARD = 250;

/**
 * The steps, in the order the flow is read: where each card stands (its centre, its top),
 * its time, and when the scroll reaches it — none for the step of the path not taken.
 */
const STEPS: Array<{ id: string; key: StepKey; icon: IconName; tone: string; x: number; y: number; ms?: number; at?: number }> = [
	{ id: 'e1', key: 'branch', icon: 'split', tone: 'amber', x: MID, y: 130, ms: 0, at: 0.12 },
	{ id: 'e2', key: 'notify', icon: 'bell', tone: 'sky', x: LEFT, y: 262, ms: 14, at: 0.3 },
	{ id: 'e3', key: 'create', icon: 'filePlus', tone: 'sky', x: LEFT, y: 334, ms: 38, at: 0.38 },
	{ id: 'e4', key: 'slack', icon: 'message', tone: 'sky', x: RIGHT, y: 262 },
	{ id: 'e5', key: 'ai', icon: 'sparkles', tone: 'violet', x: MID, y: 432, ms: 1184, at: 0.52 },
	{ id: 'e6', key: 'update', icon: 'pen', tone: 'sky', x: MID, y: 504, ms: 47, at: 0.84 },
];
const TRIGGER_AT = 0.03;
const PATH_AT = 0.21;
const MERGE_AT = 0.46;
/** The AI writes from its step until this point. */
const WRITTEN_AT = 0.8;
const DONE_AT = 0.93;

/** The links between the cards: `span`, the stretch of scroll that fills them — none off the path taken. */
const EDGES: Array<{ d: string; span?: [number, number]; off?: boolean }> = [
	{ d: `M${MID},104 V130`, span: [TRIGGER_AT, 0.12] },
	{ d: `M${MID},180 V194 H${LEFT} V208`, span: [0.12, PATH_AT] },
	{ d: `M${MID},180 V194 H${RIGHT} V208`, off: true },
	{ d: `M${LEFT},234 V262`, span: [PATH_AT, 0.3] },
	{ d: `M${RIGHT},234 V262`, off: true },
	{ d: `M${LEFT},312 V334`, span: [0.3, 0.38] },
	{ d: `M${LEFT},384 V396 H${MID} V408`, span: [0.38, MERGE_AT] },
	{ d: `M${RIGHT},312 V396 H${MID} V408`, off: true },
	{ d: `M${MID},416 V432`, span: [MERGE_AT, 0.52] },
	{ d: `M${MID},482 V504`, span: [WRITTEN_AT, 0.84] },
	{ d: `M${MID},554 V572` },
];

/** What each step did, as the editor says it on its card and in the run. */
const said = (key: StepKey) => fill(a.steps[key].run, { n: number(a.answer.length) });
const taken = STEPS.filter((s) => s.at !== undefined);
const left = (x: number) => `left:${x - CARD * 0.5}px`;
const [crumbBase, crumbScreen] = a.crumb.includes(' / ') ? a.crumb.split(' / ') : ['', a.crumb];
---

<section class="tm-section automate" data-automate>
	<div class="tm-head tm-rise">
		<p class="tm-kicker">{a.eyebrow}</p>
		<h2 class="tm-display">
			<span>{a.title}</span>
			<span class="tm-grad">{a.titleAccent}</span>
		</h2>
		<p class="tm-lede">{a.text}</p>
	</div>

	<div class="frame" data-frame aria-hidden="true">
		<div class="app" data-app>
			<div class="crumbs">
				{crumbBase !== '' && <span class="soft">{crumbBase}</span>}
				{crumbBase !== '' && <span class="soft">/</span>}
				<b>{crumbScreen}</b>
				<span class="copilot"><Icon name="sparkles" size={15} />Copilot</span>
			</div>

			<aside class="list">
				<span class="new"><Icon name="plus" size={15} stroke={2.2} />{a.create}</span>
				{
					a.list.map((item, i) => (
						<div class={i === 0 ? 'auto on' : 'auto'}>
							<span class="words">
								<b>
									<Icon name="zap" size={14} />
									<span>{item.name}</span>
								</b>
								<small>{item.when}</small>
							</span>
							<i class="toggle" />
						</div>
					))
				}
			</aside>

			<div class="editor">
				<div class="top">
					<span class="name">{a.list[0]?.name}</span>
					<span class="on-off"><i class="toggle"></i>{a.active}</span>
					<span class="btn outline"><Icon name="play" size={14} />{a.test}</span>
					<span class="btn primary">{a.save}</span>
					<span class="soft"><Icon name="more" size={18} /></span>
				</div>

				<div class="canvas">
					<div class="chips">
						<span class="clock"><Icon name="moon" size={13} />{a.clock}</span>
						<span class="done" data-done><i></i>{a.done}</span>
					</div>

					<div class="graph" data-graph>
						<svg class="edges" width="590" height="600" viewBox="0 0 590 600">
							{
								EDGES.map((e) => (
									<g class={e.off ? 'edge off' : 'edge'} data-edge={e.span?.join(' ')}>
										<path class="base" d={e.d} />
										{e.span && <path class="fill" d={e.d} pathLength="1" />}
									</g>
								))
							}
						</svg>

						<div class="card trigger" style={`${left(MID)};top:48px;height:56px`} data-at={TRIGGER_AT}>
							<span class="glyph green"><Icon name="zap" size={17} /></span>
							<span class="words">
								<small class="when">{a.when}</small>
								<b>{a.trigger}</b>
								<small>{a.table}</small>
							</span>
						</div>

						{
							STEPS.map((s) => (
								<div class={s.at === undefined ? 'card off' : 'card'} style={`${left(s.x)};top:${s.y}px`} data-at={s.at}>
									<span class={`glyph ${s.tone}`}>
										<Icon name={s.icon} size={17} />
									</span>
									<span class="words">
										<b>{a.steps[s.key].kind}</b>
										<span class="swap">
											<small class="plan">{a.steps[s.key].text}</small>
											<small class="did">{said(s.key)}</small>
										</span>
									</span>
									<span class="side">
										<code>{s.id}</code>
										{s.ms !== undefined && (
											<span class="ms">
												<Icon name="checkCircle" size={13} stroke={2} />
												{number(s.ms)} ms
											</span>
										)}
									</span>
								</div>
							))
						}

						<span class="path" style={`left:${LEFT}px;top:208px`} data-at={PATH_AT}>
							<b>{a.paths.big}</b>
							<code>{a.paths.condition}</code>
						</span>
						<span class="path otherwise off" style={`left:${RIGHT}px;top:208px`}>
							<b>{a.paths.otherwise}</b>
						</span>
						<span class="merge" style={`left:${MID}px;top:408px`} data-at={MERGE_AT}></span>
						<span class="add" style={`left:${MID}px;top:572px`}>
							<Icon name="plus" size={14} />
							{a.addStep}
						</span>
					</div>

					<div class="zoom">
						<span><Icon name="zoomIn" size={15} /></span>
						<span><Icon name="zoomOut" size={15} /></span>
						<span><Icon name="expand" size={15} /></span>
					</div>
				</div>
			</div>

			<aside class="panel">
				<div class="tabs">
					<span>{a.tabs.settings}</span>
					<span class="on">{a.tabs.runs}</span>
				</div>
				<p class="note">{a.runsText}</p>
				<div class="runs">
					<div class="run live" data-live>
						<div class="inner">
							<p class="state">
								<i class="dot"></i>
								<b class="running">{a.running}</b>
								<b class="succeeded">{a.succeeded}</b>
							</p>
							<p class="sub">{fill(a.started, { when: a.now })}</p>
							<ol class="log">
								{
									taken.map((s) => (
										<li data-at={s.at}>
											<div>
												<code>{s.id}</code>
												<span>
													{a.steps[s.key].kind} — {said(s.key)}
												</span>
												{s.key === 'ai' && (
													<span class="said" data-said data-text={a.answer}>
														<span data-shown />
														<span class="rest" data-rest>
															{a.answer}
														</span>
													</span>
												)}
											</div>
										</li>
									))
								}
							</ol>
						</div>
					</div>
					{
						a.earlier.map((when) => (
							<div class="run">
								<p class="state">
									<i class="dot ok" />
									<b>{a.succeeded}</b>
								</p>
								<p class="sub">{fill(a.started, { when })}</p>
							</div>
						))
					}
				</div>
			</aside>
		</div>
	</div>

	<div class="tm-points">
		<div class="tm-rise">
			<span class="ic"><Icon name="zap" size={22} /></span>
			<h3>{a.points.when.title}</h3>
			<p>{a.points.when.text}</p>
		</div>
		<div class="tm-rise">
			<span class="ic"><Icon name="split" size={22} /></span>
			<h3>{a.points.paths.title}</h3>
			<p>{a.points.paths.text}</p>
		</div>
		<div class="tm-rise">
			<span class="ic"><Icon name="sparkles" size={22} /></span>
			<h3>{a.points.copilot.title}</h3>
			<p>{a.points.copilot.text}</p>
		</div>
	</div>
	<p class="more tm-rise"><a class="tm-link" href={href(a.link.href)}>{a.link.label}</a></p>
</section>

<script>
	import { clamp, fit, progress, reducedMotion } from '../../lib/motion';

	const section = document.querySelector<HTMLElement>('[data-automate]');
	const frame = section?.querySelector<HTMLElement>('[data-frame]');
	if (section && frame) {
		const phone = window.matchMedia('(max-width: 760px)');
		fit(frame, () => (phone.matches ? 600 : 1080));

		/** Whatever lights up once the scroll reaches its point: cards, path, merge, lines of the run. */
		const marks = [...frame.querySelectorAll<HTMLElement>('[data-at]')].map((el) => ({
			el,
			at: Number(el.dataset.at),
		}));
		const cards = marks.filter((m) => m.el.classList.contains('card'));
		const edges = [...frame.querySelectorAll<SVGGElement>('[data-edge]')].flatMap((g) => {
			const [from, to] = (g.dataset.edge ?? '').split(' ').map(Number);
			const path = g.querySelector<SVGPathElement>('.fill');
			return path && from !== undefined && to !== undefined ? [{ path, from, to }] : [];
		});
		const offPath = [...frame.querySelectorAll<Element>('.off')];
		const live = frame.querySelector<HTMLElement>('[data-live]')!;
		const done = frame.querySelector<HTMLElement>('[data-done]')!;
		const said = frame.querySelector<HTMLElement>('[data-said]');
		const text = said?.dataset.text ?? '';
		const shown = said?.querySelector<HTMLElement>('[data-shown]');
		const rest = said?.querySelector<HTMLElement>('[data-rest]');
		const ai = said?.closest<HTMLElement>('[data-at]');
		const writeFrom = Number(ai?.dataset.at ?? 0.52);
		const WRITTEN_AT = 0.8;
		const DONE_AT = 0.93;
		const TRIGGER_AT = 0.03;
		const DECIDED_AT = 0.12;

		const update = (p: number) => {
			for (const m of marks) m.el.classList.toggle('lit', p >= m.at);
			// The card the run has reached last glows.
			const reached = cards.filter((m) => p >= m.at);
			const last = p >= DONE_AT ? null : reached[reached.length - 1]?.el;
			for (const m of cards) m.el.classList.toggle('now', m.el === last);
			for (const e of edges) {
				e.path.style.strokeDashoffset = String(1 - clamp((p - e.from) / Math.max(0.001, e.to - e.from)));
			}
			for (const el of offPath) el.classList.toggle('dim', p >= DECIDED_AT);
			live.classList.toggle('on', p >= TRIGGER_AT);
			live.classList.toggle('ok', p >= DONE_AT);
			done.classList.toggle('on', p >= DONE_AT);
			if (shown && rest) {
				const n = Math.round(text.length * clamp((p - writeFrom) / (WRITTEN_AT - writeFrom)));
				shown.textContent = text.slice(0, n);
				rest.textContent = text.slice(n);
			}
		};

		if (reducedMotion()) update(1);
		else progress(frame, update, { mode: 'pass', start: 0.85, end: 0.95 });
	}
</script>

<style>
	.frame {
		--k: 1;
		--ink: #18181b;
		--soft: #71717a;
		--line: #e4e4e7;
		--tint: #f4f4f5;
		--green: #2da31e;
		position: relative;
		width: 100%;
		max-width: 1080px;
		height: calc(700px * var(--k));
		margin: 80px auto 0;
	}
	.app {
		position: absolute;
		top: 0;
		left: 0;
		display: grid;
		grid-template-columns: 210px minmax(0, 1fr) 280px;
		grid-template-rows: 44px minmax(0, 1fr);
		width: 1080px;
		height: 700px;
		overflow: hidden;
		border: 1px solid rgba(16, 24, 16, 0.1);
		border-radius: 16px;
		font-family: var(--bd-font-sans);
		font-size: 13px;
		color: var(--ink);
		background: #fff;
		box-shadow:
			0 1px 2px rgba(16, 24, 16, 0.04),
			0 40px 80px -40px rgba(16, 24, 16, 0.35);
		transform: scale(var(--k));
		transform-origin: 0 0;
	}
	.app :global(svg) {
		flex-shrink: 0;
	}
	.soft {
		display: inline-flex;
		color: var(--soft);
	}
	code {
		font-family: var(--bd-font-mono);
	}
	.toggle {
		position: relative;
		flex-shrink: 0;
		width: 30px;
		height: 17px;
		border-radius: 999px;
		background: var(--green);
	}
	.toggle::after {
		content: '';
		position: absolute;
		top: 2px;
		right: 2px;
		width: 13px;
		height: 13px;
		border-radius: 50%;
		background: #fff;
	}

	/* Where the screen is */
	.crumbs {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 0 18px;
		border-bottom: 1px solid var(--line);
		font-size: 14px;
	}
	.copilot {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-left: auto;
		font-weight: 600;
	}

	/* The automations of the base */
	.list {
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 14px 12px;
		border-right: 1px solid var(--line);
	}
	.new {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 5px;
		height: 34px;
		margin-bottom: 8px;
		padding: 0 8px;
		overflow: hidden;
		border-radius: 8px;
		font-size: 12.5px;
		font-weight: 600;
		white-space: nowrap;
		color: #fff;
		background: var(--green);
	}
	.auto {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 9px 10px;
		border-radius: 10px;
	}
	.auto.on {
		background: var(--tint);
	}
	.auto .words {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.auto b {
		display: flex;
		align-items: center;
		gap: 6px;
		font-weight: 600;
		white-space: nowrap;
	}
	.auto b span {
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.auto b :global(svg) {
		color: var(--green);
	}
	.auto small {
		overflow: hidden;
		font-size: 11.5px;
		white-space: nowrap;
		text-overflow: ellipsis;
		color: var(--soft);
	}

	/* The editor: its bar, its canvas */
	.editor {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		grid-template-rows: 56px minmax(0, 1fr);
		min-width: 0;
	}
	.top {
		display: flex;
		align-items: center;
		gap: 10px;
		min-width: 0;
		padding: 0 14px;
		overflow: hidden;
		border-bottom: 1px solid var(--line);
	}
	.name {
		display: flex;
		flex: 1 1 150px;
		align-items: center;
		min-width: 60px;
		max-width: 190px;
		height: 32px;
		padding: 0 10px;
		overflow: hidden;
		border: 1px solid var(--line);
		border-radius: 8px;
		font-size: 13.5px;
		font-weight: 500;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.on-off {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		margin-right: auto;
		white-space: nowrap;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
		gap: 6px;
		height: 32px;
		padding: 0 11px;
		border-radius: 8px;
		font-weight: 600;
		white-space: nowrap;
	}
	.btn.outline {
		border: 1px solid var(--line);
	}
	.btn.primary {
		color: #fff;
		background: var(--green);
	}
	.canvas {
		position: relative;
		overflow: hidden;
		background-color: #fafafa;
		background-image: radial-gradient(rgba(16, 24, 16, 0.1) 1px, transparent 1px);
		background-size: 18px 18px;
	}
	.chips {
		position: absolute;
		top: 14px;
		left: 14px;
		z-index: 2;
		display: flex;
		gap: 8px;
	}
	.clock,
	.done {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		height: 28px;
		padding: 0 11px;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 600;
	}
	.clock {
		color: #e0e6ff;
		background: linear-gradient(160deg, #0b1026, #1f2760);
		font-variant-numeric: tabular-nums;
	}
	.done {
		background: #fff;
		box-shadow: 0 0 0 1px var(--line);
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity 0.35s ease,
			transform 0.35s ease;
	}
	.done.on {
		opacity: 1;
		transform: none;
	}
	.done i {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #22c55e;
	}
	.graph {
		position: absolute;
		top: 0;
		left: 50%;
		width: 590px;
		height: 600px;
		margin-left: -295px;
	}
	.edges {
		position: absolute;
		inset: 0;
		overflow: visible;
		fill: none;
		stroke-width: 1.5;
	}
	.edge .base {
		stroke: #d4d4d8;
	}
	.edge .fill {
		stroke: var(--green);
		stroke-width: 2;
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
	}
	.edge.dim,
	.card.dim,
	.path.dim {
		opacity: 0.4;
	}

	/* A card of the flow, as the editor draws it */
	.card {
		position: absolute;
		display: flex;
		align-items: center;
		gap: 9px;
		width: 250px;
		height: 50px;
		padding: 0 10px;
		border: 1px solid var(--line);
		border-radius: 12px;
		background: #fff;
		box-shadow: 0 1px 2px rgba(16, 24, 16, 0.05);
		transition:
			opacity 0.35s ease,
			border-color 0.35s ease,
			box-shadow 0.35s ease;
	}
	.card.now {
		border-color: rgba(45, 163, 30, 0.6);
		box-shadow:
			0 0 0 4px rgba(45, 163, 30, 0.12),
			0 10px 24px -14px rgba(22, 101, 52, 0.5);
	}
	.glyph {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: 9px;
	}
	.glyph.green {
		color: var(--green);
		background: rgba(45, 163, 30, 0.12);
	}
	.glyph.sky {
		color: #0369a1;
		background: rgba(14, 165, 233, 0.12);
	}
	.glyph.violet {
		color: #6d28d9;
		background: rgba(139, 92, 246, 0.12);
	}
	.glyph.amber {
		color: #b45309;
		background: rgba(245, 158, 11, 0.15);
	}
	.card .words {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
	}
	.card b {
		overflow: hidden;
		font-size: 12.5px;
		font-weight: 500;
		white-space: nowrap;
		text-overflow: ellipsis;
	}
	.card small {
		overflow: hidden;
		font-size: 11px;
		white-space: nowrap;
		text-overflow: ellipsis;
		color: var(--soft);
	}
	.card small.when {
		font-size: 9.5px;
