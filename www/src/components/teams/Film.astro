---
/**
 * The demonstration film, after the story: four and a half minutes around basedb, in
 * French, with its subtitles and its chapters — a chapter plays the film from where it
 * starts, and lights up while it plays. « Regarder la démo », in the headline, brings the
 * reader here and starts it (`data-play-demo`).
 *
 * The film is `public/video/basedb-demo-fr.mp4`, made in `basedb-video/` (its `out/`
 * folder has the film, its subtitles and its chapters).
 */
import { type Locale, i18n } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t } = i18n(locale);
const v = t.teams.video;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const seconds = (time: string) => {
	const [m = 0, s = 0] = time.split(':').map(Number);
	return m * 60 + s;
};
const chapters = v.list.map((c) => ({ ...c, at: seconds(c.time) }));
---

<section class="tm-section mist film" id="demo" data-film>
	<div class="tm-head tm-rise">
		<p class="tm-kicker">{v.eyebrow}</p>
		<h2 class="tm-display">
			<span>{v.title}</span>
			<span class="tm-grad">{v.titleAccent}</span>
		</h2>
		<p class="tm-lede">{v.text}</p>
		{locale !== 'fr' && <p class="note">{v.inFrench}</p>}
	</div>

	<div class="player tm-rise" data-player>
		<video data-video preload="metadata" playsinline poster={`${base}/video/basedb-demo-poster.jpg`}>
			<source src={`${base}/video/basedb-demo-fr.mp4`} type="video/mp4" />
			<track kind="captions" src={`${base}/video/basedb-demo-fr.vtt`} srclang="fr" label={v.captions} default={locale !== 'fr'} />
		</video>
		<button type="button" class="play" data-play>
			<span class="cta">
				<span class="disc">
					<svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z" fill="currentColor"></path></svg>
				</span>
				<span class="words">
					<b>{v.play}</b>
					<span>{v.duration}</span>
				</span>
			</span>
		</button>
	</div>

	<div class="chapters tm-rise">
		<p class="label">{v.chapters}</p>
		<ol>
			{
				chapters.map((c) => (
					<li>
						<button type="button" data-at={c.at}>
							<time>{c.time}</time>
							<span>{c.title}</span>
						</button>
					</li>
				))
			}
		</ol>
	</div>
</section>

<script>
	import { reducedMotion } from '../../lib/motion';

	const section = document.querySelector<HTMLElement>('[data-film]');
	const video = section?.querySelector<HTMLVideoElement>('[data-video]');
	const play = section?.querySelector<HTMLButtonElement>('[data-play]');
	const chapters = [...(section?.querySelectorAll<HTMLButtonElement>('[data-at]') ?? [])];
	if (section && video && play) {
		const start = (at?: number) => {
			if (at !== undefined) video.currentTime = at;
			video.controls = true;
			section.classList.add('playing');
			void video.play();
		};
		play.addEventListener('click', () => start());
		for (const chapter of chapters) {
			chapter.addEventListener('click', () => {
				start(Number(chapter.dataset.at));
				video.scrollIntoView({ behavior: reducedMotion() ? 'auto' : 'smooth', block: 'center' });
			});
		}
		// « Regarder la démo », elsewhere on the page: here, and playing — the click is the
		// reader's, so the film may start with its sound.
		for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-play-demo]')) {
			link.addEventListener('click', (event) => {
				event.preventDefault();
				video.scrollIntoView({ behavior: reducedMotion() ? 'auto' : 'smooth', block: 'center' });
				start();
			});
		}
		// The chapter playing, lit.
		const marks = chapters.map((c) => Number(c.dataset.at));
		video.addEventListener('timeupdate', () => {
			let current = -1;
			marks.forEach((at, i) => {
				if (video.currentTime >= at) current = i;
			});
			chapters.forEach((c, i) => c.toggleAttribute('data-current', i === current));
		});
	}
</script>

<style>
	.note {
		margin: 16px 0 0;
		font-size: 14px;
		color: var(--tm-slate);
	}
	.player {
		position: relative;
		max-width: 1120px;
		margin: 72px auto 0;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 28px;
		background: #0f2419;
		box-shadow:
			0 0 0 1px rgba(16, 24, 16, 0.08),
			0 60px 120px -50px rgba(16, 40, 16, 0.55);
	}
	video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	/* The whole picture plays the film; what says so sits in its corner. */
	.play {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		justify-content: flex-start;
		padding: clamp(18px, 3vw, 34px);
		color: #fff;
		background: linear-gradient(transparent 60%, rgba(0, 0, 0, 0.35));
		transition: opacity 0.35s ease;
	}
	.cta {
		display: flex;
		align-items: center;
		gap: 14px;
	}
	.disc {
		display: grid;
		place-items: center;
		width: 60px;
		height: 60px;
		padding-left: 4px;
		border-radius: 50%;
		color: #0f2419;
		background: #fff;
		box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
		transition: transform 0.3s cubic-bezier(0.3, 1.5, 0.5, 1);
	}
	.play:hover .disc,
	.play:focus-visible .disc {
		transform: scale(1.08);
	}
	.words {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 2px;
		text-align: left;
	}
	.words b {
		font-size: 19px;
		letter-spacing: -0.01em;
	}
	.words span {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.75);
	}
	.playing .play {
		opacity: 0;
		pointer-events: none;
	}

	.chapters {
		max-width: 1120px;
		margin: 32px auto 0;
	}
	.label {
		margin: 0 0 12px 4px;
		font-size: 14px;
		font-weight: 600;
		color: var(--tm-slate);
	}
	ol {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	ol button {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 4px;
		width: 100%;
		height: 100%;
		padding: 12px 14px;
		border-radius: 14px;
		text-align: left;
		transition:
			background-color 0.2s ease,
			box-shadow 0.2s ease;
	}
	ol button:hover,
	ol button[data-current] {
		background: #fff;
		box-shadow: 0 8px 20px -14px rgba(16, 24, 16, 0.35);
	}
	time {
		font-size: 12.5px;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		color: #1f9d4a;
	}
	ol span {
		font-size: 14.5px;
		font-weight: 600;
		line-height: 1.3;
		color: var(--tm-ink);
	}

	@media (max-width: 900px) {
		ol {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.player {
			border-radius: 18px;
		}
		.disc {
			width: 48px;
			height: 48px;
		}
		.words b {
			font-size: 16px;
		}
	}
	/* A phone's picture is too short for the words beside the disc: they would cover the
	   poster's tagline. The disc alone says it; the words stay for screen readers. */
	@media (max-width: 540px) {
		.words {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}
</style>
