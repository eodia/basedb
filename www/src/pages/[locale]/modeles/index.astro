---
import { type Locale, PREFIXED_LOCALES } from '../../../i18n';
import ModelesIndex from '../../../views/ModelesIndex.astro';

export function getStaticPaths() {
	return PREFIXED_LOCALES.map((l) => ({ params: { locale: l.code } }));
}

const locale = Astro.params.locale as Locale;
---

<ModelesIndex locale={locale} />
