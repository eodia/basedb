---
import Landing from '../../layouts/Landing.astro';
import { catalog, plural } from '../../lib/modeles';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = await catalog();
const categories = [...new Set(entries.map((e) => e.summary.category ?? 'Autres'))];
---

<Landing
	title="Modèles — basedb"
	description="Des bases prêtes à l’emploi : suivi de tickets, analyse d’avis, CRM, recrutement… avec leurs lignes d’exemple, leurs vues, leurs tableaux de bord et leurs champs calculés par l’IA."
>
	<main class="page">
		<header class="page-head">
			<span class="bd-label">Modèles</span>
			<h1>Une base prête en quelques secondes</h1>
			<p>
				Chaque modèle crée des tables reliées entre elles, des lignes d’exemple, des vues, un tableau
				de bord, des automatisations — et des champs que l’IA remplit elle-même. Dans basedb :
				<strong>Nouvelle base</strong>, puis <strong>Partir d’un modèle</strong>. Rien ne correspond ?
				Décrivez votre besoin en une phrase : l’IA vous propose une base sur mesure.
			</p>
			<div class="chips" role="group" aria-label="Filtrer par catégorie">
				<button type="button" class="is-on" data-filter="">Tous</button>
				{categories.map((c) => <button type="button" data-filter={c}>{c}</button>)}
			</div>
		</header>

		<div class="grid">
			{
				entries.map(({ template, summary }) => (
					<a class="card" href={`${base}/modeles/${template.key}/`} data-category={summary.category ?? 'Autres'}>
						<span class="top">
							<span class="icon" style={`background:${template.color ?? '#64748b'}`}>
								{template.label.replace(/^Démo : /, '').charAt(0)}
							</span>
							<span class="category">{summary.category ?? 'Autres'}</span>
						</span>
						<span class="title">{template.label}</span>
						<span class="summary">{template.summary}</span>
						<span class="meta">
							{summary.counts.ai_fields > 0 && <span class="ai">✦ IA</span>}
							{plural(summary.counts.tables, 'table', 'tables')} · {plural(summary.counts.rows, 'ligne', 'lignes')} ·{' '}
							{plural(summary.counts.views, 'vue', 'vues')}
						</span>
					</a>
				))
			}
		</div>

		<section class="howto">
			<h2>Paramétrer les modèles en JSON</h2>
			<p>
				Un modèle est un fichier JSON : ses tables, ses champs, ses relations, ses lignes, ses vues,
				ses tableaux de bord, ses automatisations et les consignes de ses champs IA. Les modèles de
				cette page sont les fichiers du dossier
				<a href="https://github.com/eodia/basedb/tree/main/packages/templates/catalog"><code>packages/templates/catalog</code></a>
				du dépôt ; chaque instance de basedb lit
				<a href={`${base}/modeles/catalogue.json`}><code>catalogue.json</code></a> et les propose à ses
				utilisateurs. Un administrateur peut aussi importer ses propres modèles dans son instance, et
				toute base peut être enregistrée comme modèle.
			</p>
			<p>
				<a href={`${base}/fonctionnalites/modeles/`}>Le format des modèles →</a>
			</p>
		</section>
	</main>
</Landing>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.chips button');
	for (const button of buttons) {
		button.addEventListener('click', () => {
			const wanted = button.dataset.filter ?? '';
			for (const b of buttons) b.classList.toggle('is-on', b === button);
			for (const card of document.querySelectorAll<HTMLElement>('.card')) {
				card.hidden = wanted !== '' && card.dataset.category !== wanted;
			}
		});
	}
</script>

<style>
	.page {
		max-width: 1160px;
		margin: 0 auto;
		padding: 140px 24px 64px;
	}
	.page-head {
		max-width: 820px;
	}
	.page-head h1 {
		font-size: clamp(34px, 4.6vw, 52px);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.05;
		margin: 14px 0 16px;
	}
	.page-head p {
		font-size: 17px;
		line-height: 1.6;
		color: var(--bd-text-soft);
		margin: 0 0 24px;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 40px;
	}
	.chips button {
		cursor: pointer;
		font: inherit;
		font-size: 14px;
		font-weight: 600;
		color: var(--bd-text-soft);
		background: var(--bd-muted);
		border: 1px solid var(--bd-border);
		padding: 6px 12px;
		border-radius: 999px;
		text-decoration: none;
	}
	.chips button:hover,
	.chips button.is-on {
		color: var(--bd-primary);
		border-color: var(--bd-primary);
		background: var(--bd-primary-soft);
	}
	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.category {
		font-size: 12px;
		font-weight: 600;
		color: var(--bd-muted-fg);
	}
	.card[hidden] {
		display: none;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 16px;
		margin-bottom: 48px;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 20px;
		border: 1px solid var(--bd-border);
		border-radius: var(--bd-radius);
		background: var(--bd-card);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.15s,
			box-shadow 0.15s,
			border-color 0.15s;
	}
	.card:hover {
		transform: translateY(-2px);
		border-color: rgba(42, 157, 28, 0.4);
		box-shadow: var(--bd-shadow-lg);
	}
	.icon {
		width: 40px;
		height: 40px;
		border-radius: 10px;
		display: grid;
		place-items: center;
		color: #fff;
		font-weight: 800;
		font-size: 18px;
	}
	.title {
		font-size: 17px;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.summary {
		font-size: 14.5px;
		line-height: 1.55;
		color: var(--bd-text-soft);
		flex: 1;
	}
	.meta {
		font-size: 13px;
		color: var(--bd-muted-fg);
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.ai {
		font-weight: 700;
		color: #7c3aed;
		background: #f3e8ff;
		padding: 2px 8px;
		border-radius: 999px;
	}
	.howto {
		margin-top: 24px;
		padding: 28px;
		border-radius: var(--bd-radius);
		background: var(--bd-alt-bg);
		border: 1px solid var(--bd-border-subtle);
	}
	.howto h2 {
		margin: 0 0 12px;
		font-size: 21px;
	}
	.howto p {
		color: var(--bd-text-soft);
		line-height: 1.65;
		margin: 0 0 12px;
	}
	.howto a {
		color: var(--bd-primary);
		font-weight: 600;
	}
</style>
