---
/* The template gallery, in one language: `src/pages/modeles/index.astro` (French) and `src/pages/[locale]/modeles/index.astro`. */
import { type Locale, i18n } from '../i18n';
import Landing from '../layouts/Landing.astro';
import { catalog, sortForLocale, templateText } from '../lib/modeles';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, href, html, plural } = i18n(locale);
const g = t.gallery;
const entries = sortForLocale(locale, await catalog()).map((e) => ({ ...e, text: templateText(locale, e.template) }));
// The filter's value is the file's category, the same in every language; its label is the page's.
const categories = [...new Map(entries.map((e) => [e.template.category ?? '', e.text.category])).entries()];
---

<Landing locale={locale} path="/modeles/" title={t.meta.gallery.title} description={t.meta.gallery.description}>
	<main class="page">
		<header class="page-head">
			<span class="bd-label">{g.label}</span>
			<h1>{g.title}</h1>
			<p set:html={html(g.intro)} />
			<div class="chips" role="group" aria-label={g.filter}>
				<button type="button" class="is-on" data-filter="">{g.all}</button>
				{categories.map(([value, label]) => <button type="button" data-filter={value}>{label}</button>)}
			</div>
		</header>

		<div class="grid">
			{
				entries.map(({ template, summary, text }) => (
					<a class="card" href={href(`/modeles/${template.key}/`)} data-category={template.category ?? ''}>
						<span class="top">
							<span class="icon" style={`background:${template.color ?? '#64748b'}`}>
								{text.label.replace(/^[^:：]*[:：]\s*/, '').charAt(0)}
							</span>
							<span class="category">{text.category}</span>
						</span>
						<span class="title">{text.label}</span>
						<span class="summary">{text.summary}</span>
						<span class="meta">
							{summary.counts.ai_fields > 0 && <span class="ai">{g.ai}</span>}
							{plural(g.tables, summary.counts.tables)} · {plural(g.rows, summary.counts.rows)} ·{' '}
							{plural(g.views, summary.counts.views)}
						</span>
					</a>
				))
			}
		</div>

		<section class="howto">
			<h2>{g.howtoTitle}</h2>
			<p set:html={html(g.howto)} />
			<p>
				<a href={href(g.format.href)}>{g.format.label}</a>
			</p>
		</section>
	</main>
</Landing>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.chips button');
	for (const button of buttons) {
		button.addEventListener('click', () => {
			const wanted = button.dataset.filter ?? '';
			for (const b of buttons) b.classList.toggle('is-on', b === button);
			for (const card of document.querySelectorAll<HTMLElement>('.card')) {
				card.hidden = wanted !== '' && card.dataset.category !== wanted;
			}
		});
	}
</script>

<style>
	.page {
		max-width: 1160px;
		margin: 0 auto;
		padding: 140px 24px 64px;
	}
	.page-head {
		max-width: 820px;
	}
	.page-head h1 {
		font-size: clamp(34px, 4.6vw, 52px);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.05;
		margin: 14px 0 16px;
	}
	.page-head p {
		font-size: 17px;
		line-height: 1.6;
		color: var(--bd-text-soft);
		margin: 0 0 24px;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 40px;
	}
	.chips button {
		cursor: pointer;
		font: inherit;
		font-size: 14px;
		font-weight: 600;
		color: var(--bd-text-soft);
		background: var(--bd-muted);
		border: 1px solid var(--bd-border);
		padding: 6px 12px;
		border-radius: 999px;
		text-decoration: none;
	}
	.chips button:hover,
	.chips button.is-on {
		color: var(--bd-primary);
		border-color: var(--bd-primary);
		background: var(--bd-primary-soft);
	}
	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.category {
		font-size: 12px;
		font-weight: 600;
		color: var(--bd-muted-fg);
	}
	.card[hidden] {
		display: none;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 16px;
		margin-bottom: 48px;
	}
	.card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 20px;
		border: 1px solid var(--bd-border);
		border-radius: var(--bd-radius);
		background: var(--bd-card);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.15s,
			box-shadow 0.15s,
			border-color 0.15s;
	}
	.card:hover {
		transform: translateY(-2px);
		border-color: rgba(42, 157, 28, 0.4);
		box-shadow: var(--bd-shadow-lg);
	}
	.icon {
		width: 40px;
		height: 40px;
		border-radius: 10px;
		display: grid;
		place-items: center;
		color: #fff;
		font-weight: 800;
		font-size: 18px;
	}
	.title {
		font-size: 17px;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.summary {
		font-size: 14.5px;
		line-height: 1.55;
		color: var(--bd-text-soft);
		flex: 1;
	}
	.meta {
		font-size: 13px;
		color: var(--bd-muted-fg);
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}
	.ai {
		font-weight: 700;
		color: #7c3aed;
		background: #f3e8ff;
		padding: 2px 8px;
		border-radius: 999px;
	}
	.howto {
		margin-top: 24px;
		padding: 28px;
		border-radius: var(--bd-radius);
		background: var(--bd-alt-bg);
		border: 1px solid var(--bd-border-subtle);
	}
	.howto h2 {
		margin: 0 0 12px;
		font-size: 21px;
	}
	.howto p {
		color: var(--bd-text-soft);
		line-height: 1.65;
		margin: 0 0 12px;
	}
	.howto :global(a) {
		color: var(--bd-primary);
		font-weight: 600;
	}
</style>
