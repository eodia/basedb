---
/* A template's page, in one language: `src/pages/modeles/[key].astro` (French) and `src/pages/[locale]/modeles/[key].astro`. */
import {
	type Template,
	type TemplateField,
	resolveTemplateDate,
} from '../../../packages/contracts/src/templates';
import { type Locale, fill, i18n } from '../i18n';
import Landing from '../layouts/Landing.astro';
import { templateText } from '../lib/modeles';

interface Props {
	locale: Locale;
	template: Template;
}

const { locale, template } = Astro.props;
const { t, lang, href, html, plural, number } = i18n(locale);
const g = t.gallery;
const text = templateText(locale, template);
const tableLabel = (key: string) => template.tables.find((t) => t.key === key)?.label ?? key;
const aiFields = template.tables.flatMap((t) =>
	t.fields.filter((f) => f.ai !== undefined).map((f) => ({ table: t.label, field: f.label, prompt: f.ai?.prompt ?? '' })),
);
/** A sample value as the base will show it: dates resolved from today, numbers as the page's language writes them. */
function show(value: unknown, field: TemplateField): string {
	if (Array.isArray(value)) return value.join(', ');
	if (typeof value === 'boolean') return value ? g.yes : g.no;
	if (typeof value === 'number') {
		const currency = field.format?.display === 'currency' ? (field.format.currency ?? 'EUR') : undefined;
		return currency === undefined ? number(value) : number(value, { style: 'currency', currency });
	}
	if ((field.kind === 'date' || field.kind === 'datetime') && typeof value === 'string') {
		const resolved = resolveTemplateDate(value, field.kind, new Date());
		if (resolved === null) return value;
		return field.kind === 'date'
			? new Date(`${resolved}T00:00:00`).toLocaleDateString(lang)
			: new Date(resolved).toLocaleString(lang, { dateStyle: 'short', timeStyle: 'short' });
	}
	if (value === '$moi') return g.me;
	if (typeof value === 'string' && value.startsWith('@')) return '…';
	if (field.rich === true) return words(String(value));
	return String(value);
}
/** A rich text as its words, the way a cell shows it: the page never renders a sample's HTML. */
function words(html: string): string {
	return html
		.replace(/<\/(p|li|h[1-3]|blockquote|pre)>|<br\s*\/?>/gi, '$& ')
		.replace(/<[^>]*>/g, '')
		.replace(/&nbsp;/g, ' ')
		.replace(/&lt;/g, '<')
		.replace(/&gt;/g, '>')
		.replace(/&quot;/g, '"')
		.replace(/&#39;/g, "'")
		.replace(/&amp;/g, '&')
		.replace(/\s+/g, ' ')
		.trim();
}
---

<Landing
	locale={locale}
	path={`/modeles/${template.key}/`}
	title={fill(t.meta.template.title, { label: text.label })}
	description={text.summary}
>
	<main class="page">
		<a class="back" href={href('/modeles/')}>{g.back}</a>
		<header class="head">
			<span class="icon" style={`background:${template.color ?? '#64748b'}`}>
				{text.label.replace(/^[^:：]*[:：]\s*/, '').charAt(0)}
			</span>
			<div>
				<span class="bd-label">{template.category === undefined ? g.defaultCategory : text.category}</span>
				<h1>{text.label}</h1>
				<p class="summary">{text.summary}</p>
				<div class="tags">{text.tags.map((tag) => <span>{tag}</span>)}</div>
			</div>
		</header>

		<div class="layout">
			<div class="main">
				{text.description && <p class="description">{text.description}</p>}

				<h2>{plural(g.tables, template.tables.length)}</h2>
				{
					template.tables.map((table) => {
						const rows = template.rows[table.key] ?? [];
						const links = template.links.filter((l) => l.from === table.key);
						const shown = table.fields.filter((f) => f.kind !== 'button').slice(0, 5);
						return (
							<section class="table">
								<h3>
									<span class="dot" style={`background:${table.color ?? '#94a3b8'}`} />
									{table.label}
									<small>{plural(g.sampleRows, rows.length)}</small>
								</h3>
								{table.description && <p class="muted">{table.description}</p>}
								<ul class="fields">
									{table.fields.map((f) => (
										<li class={f.ai ? 'is-ai' : ''} title={f.ai?.prompt ?? f.formula ?? f.description ?? ''}>
											{f.ai && <span class="spark">✦</span>}
											{f.label}
											<em>{g.kinds[f.rich ? 'rich_text' : f.kind] ?? f.kind}</em>
										</li>
									))}
									{links.map((l) => (
										<li class="is-link">
											{l.label}
											<em>→ {tableLabel(l.to)}</em>
										</li>
									))}
								</ul>
								{rows.length > 0 && (
									<div class="sample">
										<table>
											<thead>
												<tr>
													{shown.map((f) => (
														<th>{f.label}</th>
													))}
												</tr>
											</thead>
											<tbody>
												{rows.slice(0, 3).map((row) => (
													<tr>
														{shown.map((f) => (
															<td>{row[f.label] === undefined ? '' : show(row[f.label], f)}</td>
														))}
													</tr>
												))}
											</tbody>
										</table>
									</div>
								)}
							</section>
						);
					})
				}

				{
					aiFields.length > 0 && (
						<>
							<h2>{g.aiTitle}</h2>
							<ul class="prompts">
								{aiFields.map((f) => (
									<li>
										<strong>
											{f.table} › {f.field}
										</strong>
										<p>{f.prompt}</p>
									</li>
								))}
							</ul>
						</>
					)
				}
			</div>

			<aside class="side">
				<div class="box">
					<h2>{g.useTitle}</h2>
					<ol>
						{g.useSteps.map((step) => (
							<li set:html={html(fill(step, { label: text.label }, true))} />
						))}
						<li set:html={html(aiFields.length > 0 ? g.createWithAi : g.create)} />
					</ol>
					<a class="download" href={href(`/modeles/${template.key}.json`)} download>{g.download}</a>
					<p class="muted small">{g.downloadNote}</p>
				</div>
				{
					template.views.length > 0 && (
						<div class="box">
							<h2>{plural(g.views, template.views.length)}</h2>
							<ul class="plain">
								{template.views.map((v) => (
									<li>
										{v.label}{' '}
										<span class="muted">
											{fill(g.viewMeta, { kind: g.viewKinds[v.kind] ?? v.kind, table: tableLabel(v.table) })}
										</span>
									</li>
								))}
							</ul>
						</div>
					)
				}
				{
					(template.dashboards.length > 0 || template.automations.length > 0) && (
						<div class="box">
							{template.dashboards.map((d) => (
								<p set:html={fill(g.dashboard, { label: d.label, blocks: plural(g.blocks, d.blocks.length) }, true)} />
							))}
							{template.automations.map((a) => (
								<p>
									<Fragment set:html={fill(g.automation, { label: a.label }, true)} />
									{a.description && <span class="muted"> — {a.description}</span>}
								</p>
							))}
						</div>
					)
				}
			</aside>
		</div>
	</main>
</Landing>

<style>
	.page {
		max-width: 1160px;
		margin: 0 auto;
		padding: 120px 24px 64px;
	}
	.back {
		display: inline-block;
		margin-bottom: 24px;
		color: var(--bd-muted-fg);
		font-weight: 600;
		text-decoration: none;
	}
	.head {
		display: flex;
		gap: 20px;
		align-items: flex-start;
		margin-bottom: 32px;
	}
	.icon {
		flex-shrink: 0;
		width: 64px;
		height: 64px;
		border-radius: 16px;
		display: grid;
		place-items: center;
		color: #fff;
		font-weight: 800;
		font-size: 28px;
	}
	h1 {
		font-size: clamp(30px, 4vw, 44px);
		font-weight: 800;
		letter-spacing: -0.03em;
		margin: 8px 0 8px;
	}
	.summary {
		font-size: 17px;
		color: var(--bd-text-soft);
		margin: 0 0 12px;
	}
	.tags {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
	}
	.tags span {
		font-size: 12.5px;
		font-weight: 600;
		background: var(--bd-muted);
		border: 1px solid var(--bd-border);
		padding: 3px 10px;
		border-radius: 999px;
	}
	.layout {
		display: grid;
		grid-template-columns: 1fr 320px;
		gap: 40px;
	}
	/* The sample tables scroll within their column rather than widen it past the page. */
	.main {
		min-width: 0;
	}
	.description {
		font-size: 16px;
		line-height: 1.7;
		color: var(--bd-text-soft);
		margin: 0 0 28px;
	}
	h2 {
		font-size: 20px;
		letter-spacing: -0.02em;
		margin: 28px 0 14px;
	}
	.table {
		border: 1px solid var(--bd-border);
		border-radius: var(--bd-radius);
		padding: 18px;
		margin-bottom: 16px;
		background: var(--bd-card);
	}
	.table h3 {
		display: flex;
		align-items: center;
		gap: 8px;
		margin: 0 0 6px;
		font-size: 17px;
	}
	.table h3 small {
		margin-left: auto;
		font-size: 13px;
		font-weight: 500;
		color: var(--bd-muted-fg);
	}
	.dot {
		width: 10px;
		height: 10px;
		border-radius: 3px;
	}
	.muted {
		color: var(--bd-muted-fg);
	}
	.small {
		font-size: 13px;
	}
	.fields {
		list-style: none;
		padding: 0;
		margin: 12px 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
	}
	.fields li {
		font-size: 13.5px;
		border: 1px solid var(--bd-border);
		border-radius: 8px;
		padding: 4px 8px;
		display: inline-flex;
		gap: 6px;
		align-items: baseline;
	}
	.fields em {
		font-style: normal;
		font-size: 12px;
		color: var(--bd-muted-fg);
	}
	.fields .is-ai {
		border-color: #c4b5fd;
		background: #f5f3ff;
	}
	.fields .is-link {
		border-style: dashed;
	}
	.spark {
		color: #7c3aed;
	}
	.sample {
		overflow-x: auto;
		margin-top: 14px;
	}
	.sample table {
		border-collapse: collapse;
		font-size: 13px;
		width: 100%;
	}
	.sample th,
	.sample td {
		text-align: left;
		padding: 6px 10px;
		border-bottom: 1px solid var(--bd-border-subtle);
		max-width: 220px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.sample th {
		color: var(--bd-muted-fg);
		font-weight: 600;
	}
	.prompts {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.prompts li {
		border: 1px solid #ddd6fe;
		background: #faf5ff;
		border-radius: 12px;
		padding: 14px;
	}
	.prompts p {
		margin: 6px 0 0;
		white-space: pre-line;
		font-size: 14px;
		color: var(--bd-text-soft);
	}
	.side {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.box {
		border: 1px solid var(--bd-border);
		border-radius: var(--bd-radius);
		padding: 18px;
		background: var(--bd-alt-bg);
	}
	.box h2 {
		margin: 0 0 10px;
		font-size: 17px;
	}
	.box ol {
		margin: 0 0 14px;
		padding-left: 18px;
		line-height: 1.6;
		color: var(--bd-text-soft);
	}
	.box p {
		margin: 0 0 8px;
		font-size: 14px;
	}
	.plain {
		list-style: none;
		padding: 0;
		margin: 0;
		font-size: 14px;
		line-height: 1.8;
	}
	.download {
		display: block;
		text-align: center;
		background: var(--bd-primary);
		color: #fff;
		font-weight: 700;
		padding: 10px;
		border-radius: 10px;
		text-decoration: none;
		margin-bottom: 8px;
	}
	@media (max-width: 900px) {
		.layout {
			grid-template-columns: 1fr;
		}
	}
</style>
