---
/* The changelog, in one language: `src/pages/nouveautes.astro` (French) and `src/pages/[locale]/nouveautes.astro`. */
import { type Locale, i18n } from '../i18n';
import Landing from '../layouts/Landing.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const { t, html, date } = i18n(locale);
const c = t.changelog;
const entries = Object.values(c.entries);
---

<Landing locale={locale} path="/nouveautes/" title={t.meta.changelog.title} description={t.meta.changelog.description}>
	<main class="page">
		<header class="page-head">
			<span class="bd-label">{c.label}</span>
			<h1>{c.title}</h1>
			<p set:html={html(c.intro)} />
		</header>
		<ol class="timeline">
			{
				entries.map((e) => (
					<li>
						<div class="when">
							<time datetime={e.date}>{date(e.date)}</time>
							{e.tag && <span class="tag">{e.tag}</span>}
						</div>
						<article>
							<h2>{e.title}</h2>
							<ul>
								{e.items.map((i) => (
									<li set:html={html(i)} />
								))}
							</ul>
						</article>
					</li>
				))
			}
		</ol>
	</main>
</Landing>

<style>
	.page {
		max-width: 880px;
		margin: 0 auto;
		padding: 140px 24px 64px;
	}
	.page-head h1 {
		font-size: clamp(34px, 4.6vw, 52px);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.05;
		margin: 14px 0 16px;
	}
	.page-head p {
		font-size: 17px;
		color: var(--bd-text-soft);
		margin: 0 0 48px;
	}
	.page-head :global(a) {
		color: var(--bd-primary);
		font-weight: 600;
	}
	.timeline {
		list-style: none;
		padding: 0;
		margin: 0;
		border-left: 2px solid var(--bd-border);
	}
	.timeline > li {
		position: relative;
		display: grid;
		grid-template-columns: 170px 1fr;
		gap: 24px;
		padding: 0 0 44px 28px;
	}
	.timeline > li::before {
		content: '';
		position: absolute;
		left: -7px;
		top: 6px;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: #fff;
		border: 2px solid var(--bd-primary);
	}
	.timeline > li:first-child::before {
		background: var(--bd-primary);
		box-shadow: 0 0 0 5px rgba(63, 203, 42, 0.18);
	}
	.when {
		display: flex;
		flex-direction: column;
		gap: 8px;
		align-items: flex-start;
		font-size: 14px;
		font-weight: 600;
		color: var(--bd-muted-fg);
	}
	.tag {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--bd-primary);
		background: var(--bd-primary-soft);
		padding: 3px 8px;
		border-radius: 999px;
	}
	h2 {
		margin: 0 0 12px;
		font-size: 21px;
		letter-spacing: -0.02em;
	}
	ul {
		margin: 0;
		padding-left: 18px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		color: var(--bd-text-soft);
		font-size: 15px;
		line-height: 1.6;
	}
	ul :global(strong) {
		color: var(--bd-text);
	}
	ul :global(a) {
		color: var(--bd-primary);
		font-weight: 600;
		white-space: nowrap;
	}
	ul :global(a)::after {
		content: ' →';
	}
	@media (max-width: 720px) {
		.timeline > li {
			grid-template-columns: 1fr;
			gap: 8px;
		}
	}
</style>
