---
import '../styles/landing.css';
import Navbar from '../components/landing/Navbar.astro';
import SiteFooter from '../components/landing/SiteFooter.astro';
import { LOCALES, type Locale, i18n, localizedPath } from '../i18n';
import { languageScript } from '../i18n/detect';

interface Props {
	locale: Locale;
	/** The page, as the French site writes it: `/`, `/nouveautes/`, `/modeles/crm/`. */
	path: string;
	title: string;
	description: string;
}

const { locale, path, title, description } = Astro.props;
const { lang, t } = i18n(locale);
const info = LOCALES.find((l) => l.code === locale) ?? LOCALES[0];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(localizedPath(locale, path), Astro.site);
// What a shared link shows: the home page's headline, in the page's language
// (`public/og/<code>.jpg`, made by `scripts/og-images.mjs`).
const image = new URL(`${base}/og/${locale}.jpg`, Astro.site).href;
const alternates = LOCALES.map((l) => ({ hreflang: l.lang, href: new URL(localizedPath(l.code, path), Astro.site).href }));

// Who makes basedb, said to search engines as well as to readers: the studio's site is
// where the product belongs.
const eodia = { '@type': 'Organization', name: 'Eodia', url: 'https://eodia.com/' };
const structured = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'basedb',
	description,
	inLanguage: lang,
	url: new URL(localizedPath(locale, '/'), Astro.site).href,
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Linux, Docker',
	license: 'https://www.gnu.org/licenses/agpl-3.0.html',
	isAccessibleForFree: true,
	author: eodia,
	publisher: eodia,
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline set:html={languageScript(base)} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Eodia" />
		<link rel="canonical" href={canonical} />
		{alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
		<link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />
		<link rel="author" href={t.eodia.home} />
		<script type="application/ld+json" set:html={JSON.stringify(structured)} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={info.og} />
		<meta property="og:site_name" content="basedb" />
		<meta property="og:image" content={image} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${t.teams.hero.title} ${t.teams.hero.titleAccent}`} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="theme-color" content="#143d2b" />
		<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={`${base}/favicon.ico`} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
		<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
		<script is:inline>document.documentElement.classList.add('bd-js');</script>
	</head>
	<body>
		<Navbar locale={locale} path={path} />
		<slot />
		<SiteFooter locale={locale} path={path} />
		<script>
			// Sections fade in as they come into view; without JavaScript they are simply there.
			const items = document.querySelectorAll('.bd-reveal');
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					}
				},
				{ rootMargin: '0px 0px -10% 0px' },
			);
			for (const item of items) observer.observe(item);
		</script>
	</body>
</html>
