---
import '../styles/landing.css';
import Navbar from '../components/landing/Navbar.astro';
import SiteFooter from '../components/landing/SiteFooter.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);

// Who makes basedb, said to search engines as well as to readers: the studio's site is
// where the product belongs.
const eodia = { '@type': 'Organization', name: 'Eodia', url: 'https://eodia.com/' };
const structured = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'basedb',
	description,
	url: new URL(`${base}/`, Astro.site).href,
	applicationCategory: 'BusinessApplication',
	operatingSystem: 'Linux, Docker',
	license: 'https://www.gnu.org/licenses/agpl-3.0.html',
	isAccessibleForFree: true,
	author: eodia,
	publisher: eodia,
};
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Eodia" />
		<link rel="canonical" href={canonical} />
		<link rel="author" href="https://eodia.com/fr/" />
		<script type="application/ld+json" set:html={JSON.stringify(structured)} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="fr_FR" />
		<meta name="theme-color" content="#143d2b" />
		<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={`${base}/favicon.ico`} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
		<link rel="sitemap" href={`${base}/sitemap-index.xml`} />
		<script is:inline>document.documentElement.classList.add('bd-js');</script>
	</head>
	<body>
		<Navbar />
		<slot />
		<SiteFooter />
		<script>
			// Sections fade in as they come into view; without JavaScript they are simply there.
			const items = document.querySelectorAll('.bd-reveal');
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					}
				},
				{ rootMargin: '0px 0px -10% 0px' },
			);
			for (const item of items) observer.observe(item);
		</script>
	</body>
</html>
