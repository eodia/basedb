# basedb behind one domain, with HTTPS — `docker compose --profile https up -d`.
#
# Caddy obtains and renews the certificate on its own (ports 80 and 443 reachable, DNS
# of BASEDB_DOMAIN pointing here). In `.env`, the addresses then all name this domain:
#
#   BASEDB_DOMAIN=basedb.example.com
#   BASEDB_API=https://basedb.example.com
#   BASEDB_MCP=https://basedb.example.com/mcp
#   BASEDB_ORIGINS=https://basedb.example.com
#   BASEDB_PUBLIC_URL=https://basedb.example.com
#
# Caddy also sets X-Forwarded-For itself, from the real client address: the rate limits
# of the API (sign-in, shared forms) then count per visitor, not per proxy.

{$BASEDB_DOMAIN} {
	encode zstd gzip

	# The REST API, sign-in and the API documentation.
	@api path /api/* /auth/* /healthz
	handle @api {
		reverse_proxy api:8787
	}

	# The MCP entry point for agents (streamed answers: no buffering).
	handle /mcp* {
		reverse_proxy mcp:8788 {
			flush_interval -1
		}
	}

	# Everything else is the interface, shared forms (/f/…) included.
	handle {
		reverse_proxy web:3000
	}
}
