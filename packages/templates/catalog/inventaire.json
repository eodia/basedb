{
  "format": 1,
  "key": "inventaire",
  "label": "Inventaire et stocks",
  "summary": "Articles, fournisseurs et mouvements : le stock se calcule tout seul, les ruptures se voient d'avance.",
  "description": "Pour un atelier, une boutique ou un service généraux. Chaque entrée ou sortie est un mouvement ; le stock de chaque article en est la somme, sa valeur une formule, et les articles sous leur seuil apparaissent dans « À commander ». L'IA rédige la fiche de chaque article à partir de son nom et de sa catégorie.",
  "category": "Opérations",
  "icon": "package",
  "color": "#a16207",
  "tags": ["Cumuls", "Formules", "Galerie", "IA"],
  "base": {
    "label": "Stocks",
    "description": "Les articles en stock, leurs fournisseurs et les entrées et sorties."
  },
  "tables": [
    {
      "key": "articles",
      "label": "Articles",
      "icon": "package",
      "color": "#a16207",
      "fields": [
        { "label": "Nom", "kind": "short_text", "required": true },
        { "label": "Référence", "kind": "short_text", "format": { "display": "barcode" } },
        {
          "label": "Catégorie",
          "kind": "select",
          "options": [
            { "label": "Matériel", "color": "#3b82f6" },
            { "label": "Consommable", "color": "#10b981" },
            { "label": "Mobilier", "color": "#a16207" },
            { "label": "Emballage", "color": "#94a3b8" }
          ]
        },
        {
          "label": "Unité",
          "kind": "select",
          "options": ["pièce", "boîte", "carton", "kg", "litre"]
        },
        { "label": "Seuil d'alerte", "kind": "number" },
        {
          "label": "Prix unitaire",
          "kind": "number",
          "format": { "display": "currency", "currency": "EUR" }
        },
        {
          "label": "Stock",
          "kind": "rollup",
          "rollup": {
            "via": "Article",
            "table": "mouvements",
            "target": "Quantité",
            "aggregate": "sum"
          },
          "description": "La somme des mouvements : les sorties sont négatives."
        },
        {
          "label": "À commander",
          "kind": "formula",
          "formula": "SIVIDE([Stock]; 0) < [Seuil d'alerte]"
        },
        {
          "label": "Valeur du stock",
          "kind": "formula",
          "formula": "ARRONDI(SIVIDE([Stock]; 0) * [Prix unitaire]; 2)"
        },
        {
          "label": "Fiche",
          "kind": "long_text",
          "ai": {
            "prompt": "Rédige en deux phrases une fiche descriptive neutre de cet article de la catégorie « {{Catégorie}} », vendu à l'unité « {{Unité}} » : {{Nom}}."
          }
        }
      ]
    },
    {
      "key": "mouvements",
      "label": "Mouvements",
      "icon": "truck",
      "color": "#0ea5e9",
      "fields": [
        { "label": "Libellé", "kind": "short_text", "required": true },
        { "label": "Date", "kind": "date" },
        {
          "label": "Type",
          "kind": "select",
          "options": [
            { "label": "Entrée", "color": "#10b981", "icon": "arrow-down" },
            { "label": "Sortie", "color": "#ef4444", "icon": "arrow-up" },
            { "label": "Inventaire", "color": "#8b5cf6" }
          ]
        },
        {
          "label": "Quantité",
          "kind": "number",
          "description": "Positive pour une entrée, négative pour une sortie."
        },
        { "label": "Commentaire", "kind": "long_text" }
      ]
    },
    {
      "key": "fournisseurs",
      "label": "Fournisseurs",
      "icon": "building-2",
      "color": "#6366f1",
      "fields": [
        { "label": "Nom", "kind": "short_text", "required": true },
        { "label": "Contact", "kind": "short_text" },
        { "label": "E-mail", "kind": "email" },
        { "label": "Téléphone", "kind": "short_text", "format": { "display": "phone" } },
        { "label": "Délai (jours)", "kind": "number" },
        {
          "label": "Articles",
          "kind": "count",
          "rollup": { "via": "Fournisseur", "table": "articles" }
        },
        {
          "label": "Commander",
          "kind": "button",
          "button": { "label": "Commander", "url": "mailto:{{E-mail}}?subject=Commande" }
        }
      ]
    }
  ],
  "links": [
    { "from": "articles", "label": "Fournisseur", "to": "fournisseurs" },
    { "from": "mouvements", "label": "Article", "to": "articles" }
  ],
