  "views": [
    {
      "table": "articles",
      "label": "À commander",
      "kind": "grid",
      "spec": {
        "filter": "[À commander] eq true",
        "sorts": [{ "field": "Catégorie", "direction": "asc" }]
      }
    },
    {
      "table": "articles",
      "label": "Catalogue",
      "kind": "gallery",
      "spec": {
        "card_fields": ["Catégorie", "Stock", "Prix unitaire", "Fournisseur"],
        "color_field": "Catégorie"
      }
    },
    {
      "table": "articles",
      "label": "Par catégorie",
      "kind": "list",
      "spec": {
        "group_by": "Catégorie",
        "card_fields": ["Stock", "Seuil d'alerte", "Valeur du stock"]
      }
    },
    {
      "table": "mouvements",
      "label": "Journal",
      "kind": "grid",
      "spec": {
        "sorts": [{ "field": "Date", "direction": "desc" }],
        "group_by": "Type",
        "summaries": { "Quantité": "sum" }
      }
    },
    {
      "table": "mouvements",
      "label": "Calendrier",
      "kind": "calendar",
      "spec": {
        "date_field": "Date",
        "color_field": "Type",
        "card_fields": ["Article", "Quantité"]
      }
    }
  ],
  "dashboards": [
    {
      "label": "Stocks",
      "blocks": [
        {
          "kind": "number",
          "title": "Articles à commander",
          "table": "articles",
          "aggregate": "count",
          "filter": "[À commander] eq true"
        },
        { "kind": "number", "title": "Articles suivis", "table": "articles", "aggregate": "count" },
        {
          "kind": "number",
          "title": "Sorties ce mois-ci",
          "table": "mouvements",
          "aggregate": "count",
          "filter": "[Type] eq \"Sortie\""
        },
        {
          "kind": "chart",
          "title": "Articles par catégorie",
          "table": "articles",
          "group_by": "Catégorie",
          "style": "pie"
        },
        {
          "kind": "chart",
          "title": "Mouvements par type",
          "table": "mouvements",
          "group_by": "Type",
          "style": "bar",
          "width": 2
        },
        {
          "kind": "list",
          "title": "Derniers mouvements",
          "table": "mouvements",
          "fields": ["Libellé", "Article", "Quantité"],
          "sort": "-Date",
          "limit": 6,
          "width": 3
        }
      ]
    }
  ],
  "automations": [
    {
      "label": "Grosse sortie",
      "description": "Prévient quand une sortie dépasse 50 unités.",
      "trigger": { "kind": "record_created", "table": "mouvements" },
      "condition": "[Quantité] lt -50",
      "actions": [
        {
          "kind": "notify",
          "users": ["$moi"],
          "message": "Grosse sortie : {{Libellé}} ({{Quantité}})"
        }
      ]
    }
  ]
}
