{
  "format": 1,
  "key": "demo",
  "label": "Démo : Atelier Lumen",
  "summary": "Une petite agence, ses clients, projets, tâches, factures et avis : toutes les facettes de basedb dans une seule base.",
  "description": "La base de démonstration. Atelier Lumen est une agence de design fictive. Sa base montre les relations entre tables, les recherches et cumuls (chiffre d'affaires par client, note moyenne), les formules (montant TTC, retard), trois champs calculés par l'IA sur les avis clients (sentiment, thème, réponse suggérée), chaque sorte de vue — grille, kanban, calendrier, chronologie avec dépendances, galerie, liste, formulaire —, un tableau de bord et deux automatisations.",
  "category": "Démonstration",
  "icon": "sparkles",
  "color": "#8b5cf6",
  "tags": ["IA", "Relations", "Toutes les vues", "Tableau de bord"],
  "base": {
    "label": "Démo — Atelier Lumen",
    "description": "Base de démonstration : une agence de design, ses clients, projets, tâches, factures et avis. Elle sert à explorer les relations, les calculs, l'IA, les vues, les tableaux de bord et les automatisations."
  },
  "tables": [
    {
      "key": "clients",
      "label": "Clients",
      "icon": "building-2",
      "color": "#3b82f6",
      "description": "Les organisations pour qui l'agence travaille, prospects compris. Une ligne par client.",
      "fields": [
        {
          "label": "Nom",
          "kind": "short_text",
          "required": true,
          "description": "Nom usuel du client, tel qu'il apparaît sur les devis."
        },
        {
          "label": "Secteur",
          "kind": "select",
          "options": ["Commerce", "Santé", "Éducation", "Industrie", "Association"]
        },
        {
          "label": "Statut",
          "kind": "select",
          "options": [
            { "label": "Prospect", "color": "#f59e0b" },
            { "label": "Actif", "color": "#10b981" },
            { "label": "Ancien", "color": "#94a3b8" }
          ]
        },
        { "label": "Ville", "kind": "short_text" },
        { "label": "E-mail", "kind": "email", "description": "Adresse du contact principal." },
        { "label": "Site web", "kind": "url" },
        {
          "label": "Projets",
          "kind": "count",
          "rollup": { "via": "Client", "table": "projets" },
          "description": "Nombre de projets menés pour ce client."
        },
        {
          "label": "Chiffre d'affaires",
          "kind": "rollup",
          "rollup": {
            "via": "Client",
            "table": "factures",
            "target": "Montant HT",
            "aggregate": "sum"
          },
          "description": "Somme des montants HT facturés au client."
        },
        {
          "label": "Note moyenne",
          "kind": "rollup",
          "rollup": { "via": "Client", "table": "avis", "target": "Note", "aggregate": "avg" },
          "description": "Moyenne des notes laissées par le client, sur 5."
        },
        {
          "label": "Écrire",
          "kind": "button",
          "button": { "label": "Écrire", "url": "mailto:{{E-mail}}" }
        }
      ]
    },
    {
      "key": "projets",
      "label": "Projets",
      "icon": "rocket",
      "color": "#8b5cf6",
      "description": "Les missions de l'agence, de l'idée à la livraison. Un projet a un client et des tâches.",
      "fields": [
        { "label": "Nom", "kind": "short_text", "required": true },
        {
          "label": "Statut",
          "kind": "select",
          "options": [
            { "label": "Idée", "color": "#94a3b8" },
            { "label": "En cours", "color": "#3b82f6" },
            { "label": "En pause", "color": "#f59e0b" },
            { "label": "Livré", "color": "#10b981" }
          ]
        },
        { "label": "Début", "kind": "date" },
        { "label": "Fin", "kind": "date" },
        {
          "label": "Budget",
          "kind": "number",
          "format": { "display": "currency", "currency": "EUR" }
        },
        {
          "label": "Durée (jours)",
          "kind": "formula",
          "formula": "JOURS([Fin]; [Début])",
          "description": "Nombre de jours entre le début et la fin prévue."
        },
        {
          "label": "Ville du client",
          "kind": "lookup",
          "rollup": { "via": "Client", "target": "Ville" }
        },
        { "label": "Tâches", "kind": "count", "rollup": { "via": "Projet", "table": "taches" } }
      ]
    },
    {
      "key": "taches",
      "label": "Tâches",
      "icon": "list-todo",
      "color": "#10b981",
      "description": "Le travail à faire, projet par projet. Une tâche peut dépendre d'autres tâches.",
      "fields": [
        { "label": "Titre", "kind": "short_text", "required": true },
        {
          "label": "Statut",
          "kind": "select",
          "options": [
            { "label": "À faire", "color": "#94a3b8" },
            { "label": "En cours", "color": "#3b82f6" },
            { "label": "En revue", "color": "#f59e0b" },
            { "label": "Fait", "color": "#10b981" }
          ]
        },
        {
          "label": "Priorité",
          "kind": "select",
          "options": [
            { "label": "Haute", "color": "#ef4444", "icon": "flame" },
            { "label": "Moyenne", "color": "#f59e0b" },
            { "label": "Basse", "color": "#94a3b8" }
          ]
        },
        { "label": "Début", "kind": "date" },
        { "label": "Échéance", "kind": "date" },
        { "label": "Assigné à", "kind": "user" },
        { "label": "Estimation (h)", "kind": "number" },
        { "label": "Notes", "kind": "long_text" },
        {
          "label": "Terminée le",
          "kind": "datetime",
          "description": "Rempli par l'automatisation « Tâche terminée »."
        }
      ]
    },
    {
      "key": "factures",
      "label": "Factures",
      "icon": "receipt",
      "color": "#f59e0b",
      "description": "Les factures émises. Une facture vise un client, et souvent un projet.",
      "fields": [
        {
          "label": "Numéro",
          "kind": "short_text",
          "required": true,
          "description": "Référence imprimée sur la facture, par exemple F-2026-012."
        },
        { "label": "Émise le", "kind": "date" },
        {
          "label": "Montant HT",
          "kind": "number",
          "format": { "display": "currency", "currency": "EUR" }
        },
        { "label": "Taux de TVA", "kind": "number", "description": "0,2 pour 20 %." },
        {
          "label": "Montant TTC",
          "kind": "formula",
          "formula": "ARRONDI([Montant HT] * (1 + [Taux de TVA]); 2)"
        },
        { "label": "Échéance", "kind": "date" },
        { "label": "Payée", "kind": "boolean" },
        {
          "label": "En retard",
          "kind": "formula",
          "formula": "SI([Payée]; FAUX; JOURS(AUJOURDHUI(); [Échéance]) > 0)",
          "description": "Vrai quand l'échéance est passée et la facture non payée."
        }
      ]
    },
    {
      "key": "avis",
      "label": "Avis clients",
      "icon": "message-square",
      "color": "#ec4899",
      "description": "Ce que les clients disent du travail livré. L'IA lit chaque avis : sentiment, thème et proposition de réponse.",
      "fields": [
        { "label": "Auteur", "kind": "short_text", "required": true },
        { "label": "Avis", "kind": "long_text", "description": "Le texte laissé par le client." },
        { "label": "Note", "kind": "number", "format": { "display": "rating", "rating_max": 5 } },
        { "label": "Reçu le", "kind": "date" },
        {
          "label": "Sentiment",
          "kind": "select",
          "options": [
            { "label": "Positif", "color": "#10b981", "icon": "smile" },
            { "label": "Neutre", "color": "#94a3b8", "icon": "meh" },
            { "label": "Négatif", "color": "#ef4444", "icon": "frown" }
          ],
          "ai": {
            "prompt": "Voici l'avis d'un client sur une agence de design, noté {{Note}}/5 :\n« {{Avis}} »\nQuel est le sentiment général de cet avis ?"
          },
          "description": "Calculé par l'IA à partir du texte et de la note."
        },
        {
          "label": "Thème",
          "kind": "select",
          "options": ["Qualité", "Délais", "Prix", "Communication", "Autre"],
          "ai": { "prompt": "De quoi parle principalement cet avis client ? « {{Avis}} »" },
          "description": "Le sujet principal de l'avis, selon l'IA."
        },
        {
          "label": "Réponse suggérée",
          "kind": "long_text",
          "ai": {
            "prompt": "Rédige en trois phrases au plus une réponse chaleureuse et professionnelle à cet avis client, noté {{Note}}/5. Remercie, réponds précisément aux remarques, et signe « L'équipe Atelier Lumen ».\nAvis de {{Auteur}} : « {{Avis}} »"
          },
          "description": "Un brouillon de réponse, à relire avant envoi."
        }
      ]
    }
  ],
  "links": [
    {
      "from": "projets",
      "label": "Client",
      "to": "clients",
      "description": "Le client pour qui le projet est mené."
    },
    { "from": "taches", "label": "Projet", "to": "projets" },
    {
      "from": "taches",
      "label": "Dépend de",
      "to": "taches",
      "multiple": true,
      "description": "Les tâches à terminer avant de commencer celle-ci."
    },
    { "from": "factures", "label": "Client", "to": "clients" },
    { "from": "factures", "label": "Projet", "to": "projets" },
    { "from": "avis", "label": "Client", "to": "clients" }
  ],
