      "table": "projets",
      "label": "Par statut",
      "kind": "kanban",
      "spec": {
        "group_by": "Statut",
        "card_fields": ["Client", "Budget", "Fin"],
        "group_order": ["Idée", "En cours", "En pause", "Livré"]
      }
    },
    {
      "table": "projets",
      "label": "Planning",
      "kind": "timeline",
      "spec": {
        "start_field": "Début",
        "end_field": "Fin",
        "color_field": "Statut",
        "scale": "month"
      }
    },
    {
      "table": "taches",
      "label": "Tableau",
      "kind": "kanban",
      "spec": {
        "group_by": "Statut",
        "card_fields": ["Priorité", "Échéance", "Projet", "Assigné à"],
        "group_order": ["À faire", "En cours", "En revue", "Fait"]
      }
    },
    {
      "table": "taches",
      "label": "Échéances",
      "kind": "calendar",
      "spec": { "date_field": "Échéance", "color_field": "Priorité", "card_fields": ["Projet"] }
    },
    {
      "table": "taches",
      "label": "Dépendances",
      "kind": "timeline",
      "spec": {
        "start_field": "Début",
        "end_field": "Échéance",
        "depends_on": "Dépend de",
        "group_by": "Projet",
        "color_field": "Statut",
        "scale": "week"
      }
    },
    {
      "table": "taches",
      "label": "À faire",
      "kind": "grid",
      "spec": {
        "filter": "[Statut] ne \"Fait\"",
        "sorts": [{ "field": "Échéance", "direction": "asc" }],
        "group_by": "Priorité"
      }
    },
    {
      "table": "factures",
      "label": "Impayées",
      "kind": "grid",
      "spec": {
        "filter": "[Payée] eq false",
        "sorts": [{ "field": "Échéance", "direction": "asc" }],
        "summaries": { "Montant HT": "sum" }
      }
    },
    {
      "table": "avis",
      "label": "Par sentiment",
      "kind": "kanban",
      "spec": {
        "group_by": "Sentiment",
        "card_fields": ["Note", "Thème", "Client"],
        "group_order": ["Négatif", "Neutre", "Positif"]
      }
    },
    {
      "table": "avis",
      "label": "Donnez votre avis",
      "kind": "form",
      "spec": {
        "title": "Votre avis sur Atelier Lumen",
        "description": "Deux minutes pour nous dire ce que vous avez pensé de notre travail. Merci !",
        "fields": [
          { "field": "Auteur", "required": true, "label": "Votre nom et votre organisation" },
          { "field": "Note", "required": true },
          {
            "field": "Avis",
            "required": true,
            "label": "Votre avis",
            "help": "Ce qui vous a plu, ce que nous pourrions mieux faire."
          }
        ],
        "submit_label": "Envoyer mon avis",
        "success_message": "Merci, votre avis nous aide à progresser."
      }
    }
  ],
  "dashboards": [
    {
      "label": "Pilotage de l'agence",
      "description": "L'essentiel en un coup d'œil.",
      "blocks": [
        {
          "kind": "number",
          "title": "Projets en cours",
          "table": "projets",
          "aggregate": "count",
          "filter": "[Statut] eq \"En cours\""
        },
        {
          "kind": "number",
          "title": "Encaissé (HT)",
          "table": "factures",
          "aggregate": "sum",
          "field": "Montant HT",
          "filter": "[Payée] eq true"
        },
        {
          "kind": "number",
          "title": "Note moyenne des avis",
          "table": "avis",
          "aggregate": "avg",
          "field": "Note"
        },
        {
          "kind": "chart",
          "title": "Tâches par statut",
          "table": "taches",
          "group_by": "Statut",
          "style": "bar",
          "width": 2
        },
        {
          "kind": "chart",
          "title": "Sentiment des avis",
          "table": "avis",
          "group_by": "Sentiment",
          "style": "pie"
        },
        {
          "kind": "list",
          "title": "Prochaines échéances",
          "table": "taches",
          "fields": ["Titre", "Échéance", "Priorité"],
          "filter": "[Statut] ne \"Fait\"",
          "sort": "Échéance",
          "limit": 6,
          "width": 2
        },
        {
          "kind": "text",
          "title": "Bienvenue",
          "body": "Cette base est une démonstration. Ouvrez « Avis clients » pour voir l'IA lire les avis, « Tâches » pour les vues kanban, calendrier et dépendances, et « Automatisations » pour ce qui se passe quand une tâche est terminée."
        }
      ]
    }
  ],
  "automations": [
    {
      "label": "Tâche terminée",
      "description": "Note l'heure à laquelle une tâche passe à « Fait ».",
      "trigger": { "kind": "record_updated", "table": "taches", "fields": ["Statut"] },
      "condition": "[Statut] eq \"Fait\"",
      "actions": [{ "kind": "update_record", "values": { "Terminée le": "{{_maintenant}}" } }]
    },
    {
      "label": "Avis négatif",
      "description": "Prévient dès que l'IA juge un avis négatif.",
      "trigger": { "kind": "record_updated", "table": "avis", "fields": ["Sentiment"] },
      "condition": "[Sentiment] eq \"Négatif\"",
      "actions": [
        {
          "kind": "notify",
          "users": ["$moi"],
          "message": "Avis négatif de {{Auteur}} : « {{Avis}} »"
        }
      ]
    }
  ]
}
