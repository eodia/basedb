{
  "format": 1,
  "key": "crm",
  "label": "CRM commercial",
  "summary": "Entreprises, contacts et opportunités : un pipeline de vente, les échanges, et l'IA qui conseille la prochaine étape.",
  "description": "Un CRM léger pour une équipe commerciale. Les opportunités avancent dans un pipeline, portent un montant pondéré par leur probabilité, et l'IA en évalue le risque et conseille la prochaine action à partir des notes. Les échanges avec les clients sont consignés et résumés, les entreprises cumulent ce qu'elles représentent.",
  "category": "Ventes",
  "icon": "handshake",
  "color": "#0ea5e9",
  "tags": ["IA", "Pipeline", "Kanban", "Calendrier"],
  "base": {
    "label": "CRM",
    "description": "Les clients, leurs contacts et les ventes en cours, de la découverte à la signature."
  },
  "tables": [
    {
      "key": "opportunites",
      "label": "Opportunités",
      "icon": "target",
      "color": "#0ea5e9",
      "description": "Une vente possible, de la découverte à la signature ou à l'abandon.",
      "fields": [
        { "label": "Nom", "kind": "short_text", "required": true },
        {
          "label": "Étape",
          "kind": "select",
          "options": [
            { "label": "Découverte", "color": "#94a3b8" },
            { "label": "Qualification", "color": "#8b5cf6" },
            { "label": "Proposition", "color": "#3b82f6" },
            { "label": "Négociation", "color": "#f59e0b" },
            { "label": "Gagnée", "color": "#10b981", "icon": "trophy" },
            { "label": "Perdue", "color": "#ef4444" }
          ]
        },
        {
          "label": "Montant",
          "kind": "number",
          "format": { "display": "currency", "currency": "EUR" }
        },
        {
          "label": "Probabilité (%)",
          "kind": "number",
          "description": "Chance de signer, de 0 à 100."
        },
        {
          "label": "Montant pondéré",
          "kind": "formula",
          "formula": "ARRONDI([Montant] * [Probabilité (%)] / 100; 0)",
          "description": "Le montant multiplié par la probabilité."
        },
        { "label": "Clôture prévue", "kind": "date" },
        { "label": "Responsable", "kind": "user" },
        {
          "label": "Notes",
          "kind": "long_text",
          "description": "Ce que l'on sait du besoin, du budget, des décideurs et des objections."
        },
        {
          "label": "Risque",
          "kind": "select",
          "options": [
            { "label": "Faible", "color": "#10b981" },
            { "label": "Moyen", "color": "#f59e0b" },
            { "label": "Élevé", "color": "#ef4444" }
          ],
          "ai": {
            "prompt": "Voici les notes d'un commercial sur une opportunité à l'étape « {{Étape}} », d'un montant de {{Montant}} € :\n{{Notes}}\nQuel est le risque de ne pas signer ?"
          }
        },
        {
          "label": "Prochaine étape conseillée",
          "kind": "short_text",
          "ai": {
            "prompt": "En une phrase de 15 mots au plus, quelle est la prochaine action commerciale la plus utile pour faire avancer cette opportunité (étape « {{Étape}} ») ?\nNotes : {{Notes}}"
          }
        }
      ]
    },
    {
      "key": "entreprises",
      "label": "Entreprises",
      "icon": "building-2",
      "color": "#6366f1",
      "description": "Les comptes clients et prospects.",
      "fields": [
        { "label": "Nom", "kind": "short_text", "required": true },
        {
          "label": "Secteur",
          "kind": "select",
          "options": ["Industrie", "Services", "Commerce", "Santé", "Public"]
        },
        { "label": "Taille", "kind": "select", "options": ["TPE", "PME", "ETI", "Grand compte"] },
        { "label": "Ville", "kind": "short_text" },
        { "label": "Site web", "kind": "url" },
        {
          "label": "Opportunités",
          "kind": "count",
          "rollup": { "via": "Entreprise", "table": "opportunites" }
        },
        {
          "label": "Montant en jeu",
          "kind": "rollup",
          "rollup": {
            "via": "Entreprise",
            "table": "opportunites",
            "target": "Montant",
            "aggregate": "sum"
          }
        }
      ]
    },
    {
      "key": "contacts",
      "label": "Contacts",
      "icon": "users",
      "color": "#14b8a6",
      "description": "Les personnes à qui l'on parle chez les clients.",
      "fields": [
        { "label": "Nom", "kind": "short_text", "required": true },
        { "label": "Fonction", "kind": "short_text" },
        { "label": "E-mail", "kind": "email" },
        { "label": "Téléphone", "kind": "short_text", "format": { "display": "phone" } },
        {
          "label": "Rôle dans la décision",
          "kind": "select",
          "options": ["Décideur", "Prescripteur", "Utilisateur", "Acheteur"]
        },
        {
          "label": "Écrire",
          "kind": "button",
          "button": { "label": "Écrire", "url": "mailto:{{E-mail}}" }
        }
      ]
    },
    {
      "key": "echanges",
      "label": "Échanges",
      "icon": "message-square",
      "color": "#f59e0b",
      "description": "Appels, rendez-vous, démonstrations : ce qui s'est dit, et quand.",
      "fields": [
        { "label": "Sujet", "kind": "short_text", "required": true },
        {
          "label": "Type",
          "kind": "select",
          "options": [
            { "label": "Appel", "icon": "phone" },
            { "label": "E-mail", "icon": "mail" },
            { "label": "Rendez-vous", "icon": "users" },
            { "label": "Démonstration", "icon": "monitor" }
          ]
        },
        { "label": "Date", "kind": "datetime" },
        { "label": "Compte rendu", "kind": "long_text" },
        {
          "label": "Points clés",
          "kind": "short_text",
          "ai": {
            "prompt": "Résume en 20 mots au plus les points clés de cet échange commercial :\n{{Compte rendu}}"
          }
        }
      ]
    }
  ],
  "links": [
    { "from": "opportunites", "label": "Entreprise", "to": "entreprises" },
    { "from": "opportunites", "label": "Contact", "to": "contacts" },
    { "from": "contacts", "label": "Entreprise", "to": "entreprises" },
    { "from": "echanges", "label": "Opportunité", "to": "opportunites" }
  ],
