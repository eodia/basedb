  "views": [
    {
      "table": "opportunites",
      "label": "Pipeline",
      "kind": "kanban",
      "spec": {
        "group_by": "Étape",
        "card_fields": ["Entreprise", "Montant", "Clôture prévue", "Risque"],
        "group_order": [
          "Découverte",
          "Qualification",
          "Proposition",
          "Négociation",
          "Gagnée",
          "Perdue"
        ]
      }
    },
    {
      "table": "opportunites",
      "label": "En cours par risque",
      "kind": "grid",
      "spec": {
        "filter": "[Étape] ne \"Gagnée\" and [Étape] ne \"Perdue\"",
        "group_by": "Risque",
        "sorts": [{ "field": "Clôture prévue", "direction": "asc" }],
        "summaries": { "Montant": "sum" }
      }
    },
    {
      "table": "opportunites",
      "label": "Clôtures",
      "kind": "calendar",
      "spec": { "date_field": "Clôture prévue", "color_field": "Étape", "card_fields": ["Montant"] }
    },
    {
      "table": "echanges",
      "label": "Agenda",
      "kind": "calendar",
      "spec": {
        "date_field": "Date",
        "color_field": "Type",
        "card_fields": ["Opportunité"],
        "mode": "week"
      }
    },
    {
      "table": "entreprises",
      "label": "Comptes",
      "kind": "gallery",
      "spec": {
        "card_fields": ["Secteur", "Taille", "Ville", "Montant en jeu"],
        "color_field": "Taille"
      }
    },
    {
      "table": "contacts",
      "label": "Par entreprise",
      "kind": "list",
      "spec": {
        "group_by": "Entreprise",
        "card_fields": ["Fonction", "E-mail", "Rôle dans la décision"]
      }
    }
  ],
  "dashboards": [
    {
      "label": "Ventes",
      "blocks": [
        {
          "kind": "number",
          "title": "En jeu",
          "table": "opportunites",
          "aggregate": "sum",
          "field": "Montant",
          "filter": "[Étape] ne \"Gagnée\" and [Étape] ne \"Perdue\""
        },
        {
          "kind": "number",
          "title": "Gagné",
          "table": "opportunites",
          "aggregate": "sum",
          "field": "Montant",
          "filter": "[Étape] eq \"Gagnée\""
        },
        {
          "kind": "number",
          "title": "Opportunités ouvertes",
          "table": "opportunites",
          "aggregate": "count",
          "filter": "[Étape] ne \"Gagnée\" and [Étape] ne \"Perdue\""
        },
        {
          "kind": "chart",
          "title": "Pipeline par étape",
          "table": "opportunites",
          "group_by": "Étape",
          "style": "bar",
          "width": 2
        },
        {
          "kind": "chart",
          "title": "Risque",
          "table": "opportunites",
          "group_by": "Risque",
          "style": "pie"
        },
        {
          "kind": "list",
          "title": "Prochaines clôtures",
          "table": "opportunites",
          "fields": ["Nom", "Montant", "Clôture prévue", "Prochaine étape conseillée"],
          "filter": "[Étape] ne \"Gagnée\" and [Étape] ne \"Perdue\"",
          "sort": "Clôture prévue",
          "limit": 5,
          "width": 3
        }
      ]
    }
  ],
  "automations": [
    {
      "label": "Opportunité gagnée",
      "description": "Prévient le responsable quand une opportunité est gagnée.",
      "trigger": { "kind": "record_updated", "table": "opportunites", "fields": ["Étape"] },
      "condition": "[Étape] eq \"Gagnée\"",
      "actions": [
        {
          "kind": "notify",
          "users": ["$moi"],
          "user_field": "Responsable",
          "message": "Gagnée : {{Nom}} ({{Montant}} €)"
        }
      ]
    }
  ]
}
