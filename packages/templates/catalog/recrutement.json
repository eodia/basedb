  "views": [
    {
      "table": "candidats",
      "label": "Pipeline",
      "kind": "kanban",
      "spec": {
        "group_by": "Étape",
        "card_fields": ["Poste", "Source", "Évaluation"],
        "group_order": ["Candidature", "Présélection", "Entretien", "Offre", "Embauché", "Refusé"]
      }
    },
    {
      "table": "candidats",
      "label": "À traiter",
      "kind": "grid",
      "spec": {
        "filter": "[Étape] eq \"Candidature\"",
        "sorts": [{ "field": "Reçue le", "direction": "asc" }]
      }
    },
    {
      "table": "candidats",
      "label": "Postuler",
      "kind": "form",
      "spec": {
        "title": "Postuler",
        "description": "Présentez-vous en quelques lignes : nous répondons à chaque candidature sous dix jours.",
        "fields": [
          { "field": "Nom", "required": true, "label": "Prénom et nom" },
          { "field": "E-mail", "required": true },
          { "field": "Téléphone" },
          {
            "field": "Lettre de motivation",
            "required": true,
            "label": "Pourquoi nous rejoindre ?",
            "help": "Votre parcours, ce que vous cherchez, le poste qui vous intéresse."
          }
        ],
        "submit_label": "Envoyer ma candidature",
        "success_message": "Merci ! Nous revenons vers vous sous dix jours."
      }
    },
    {
      "table": "entretiens",
      "label": "Agenda",
      "kind": "calendar",
      "spec": {
        "date_field": "Date",
        "color_field": "Avis",
        "card_fields": ["Candidat", "Type"],
        "mode": "week"
      }
    },
    {
      "table": "postes",
      "label": "Postes ouverts",
      "kind": "gallery",
      "spec": {
        "filter": "[Ouvert] eq true",
        "card_fields": ["Service", "Contrat", "Lieu", "Candidatures"],
        "color_field": "Service"
      }
    }
  ],
  "dashboards": [
    {
      "label": "Recrutements",
      "blocks": [
        {
          "kind": "number",
          "title": "Candidatures en cours",
          "table": "candidats",
          "aggregate": "count",
          "filter": "[Étape] ne \"Embauché\" and [Étape] ne \"Refusé\""
        },
        {
          "kind": "number",
          "title": "Postes ouverts",
          "table": "postes",
          "aggregate": "count",
          "filter": "[Ouvert] eq true"
        },
        {
          "kind": "number",
          "title": "Évaluation moyenne",
          "table": "candidats",
          "aggregate": "avg",
          "field": "Évaluation"
        },
        {
          "kind": "chart",
          "title": "Par étape",
          "table": "candidats",
          "group_by": "Étape",
          "style": "bar",
          "width": 2
        },
        {
          "kind": "chart",
          "title": "Sources",
          "table": "candidats",
          "group_by": "Source",
          "style": "pie"
        },
        {
          "kind": "list",
          "title": "Prochains entretiens",
          "table": "entretiens",
          "fields": ["Titre", "Date", "Type"],
          "sort": "Date",
          "limit": 5,
          "width": 3
        }
      ]
    }
  ],
  "automations": [
    {
      "label": "Nouvelle candidature",
      "description": "Prévient à chaque candidature reçue.",
      "trigger": { "kind": "record_created", "table": "candidats" },
      "actions": [
        { "kind": "notify", "users": ["$moi"], "message": "Nouvelle candidature : {{Nom}}" }
      ]
    }
  ]
}
