{
  "format": 1,
  "key": "recrutement",
  "label": "Recrutement",
  "summary": "Postes ouverts, candidats et entretiens ; l'IA synthétise chaque candidature et suggère les points à creuser.",
  "description": "Un suivi des recrutements, de la candidature à l'embauche. Les candidats postulent par un formulaire public, avancent étape par étape dans un kanban, et les entretiens se planifient dans un calendrier. L'IA lit la lettre de motivation et les notes : une synthèse, et les questions à poser en entretien. Elle aide à lire, elle ne décide pas.",
  "category": "Ressources humaines",
  "icon": "users",
  "color": "#14b8a6",
  "tags": ["IA", "Formulaire", "Kanban", "Calendrier"],
  "base": {
    "label": "Recrutement",
    "description": "Les postes ouverts, les candidatures reçues et les entretiens."
  },
  "tables": [
    {
      "key": "candidats",
      "label": "Candidats",
      "icon": "user",
      "color": "#14b8a6",
      "fields": [
        { "label": "Nom", "kind": "short_text", "required": true },
        { "label": "E-mail", "kind": "email" },
        { "label": "Téléphone", "kind": "short_text", "format": { "display": "phone" } },
        {
          "label": "Étape",
          "kind": "select",
          "options": [
            { "label": "Candidature", "color": "#94a3b8" },
            { "label": "Présélection", "color": "#8b5cf6" },
            { "label": "Entretien", "color": "#3b82f6" },
            { "label": "Offre", "color": "#f59e0b" },
            { "label": "Embauché", "color": "#10b981", "icon": "trophy" },
            { "label": "Refusé", "color": "#ef4444" }
          ]
        },
        {
          "label": "Source",
          "kind": "select",
          "options": ["Site carrières", "LinkedIn", "Cooptation", "Salon", "Candidature spontanée"]
        },
        { "label": "Reçue le", "kind": "date" },
        { "label": "Lettre de motivation", "kind": "long_text" },
        {
          "label": "Notes",
          "kind": "long_text",
          "description": "Les impressions de l'équipe au fil du processus."
        },
        {
          "label": "Évaluation",
          "kind": "number",
          "format": { "display": "rating", "rating_max": 5 },
          "description": "La note de l'équipe, après entretien."
        },
        {
          "label": "Poste visé",
          "kind": "lookup",
          "rollup": { "via": "Poste", "target": "Intitulé" }
        },
        {
          "label": "Synthèse",
          "kind": "long_text",
          "ai": {
            "prompt": "Résume en trois phrases factuelles cette candidature : parcours, motivations, points forts.\nLettre : {{Lettre de motivation}}\nNotes de l'équipe : {{Notes}}"
          }
        },
        {
          "label": "Questions à poser",
          "kind": "long_text",
          "ai": {
            "prompt": "Propose trois questions précises à poser en entretien pour vérifier ce qui reste flou dans cette candidature. Une question par ligne.\nLettre : {{Lettre de motivation}}"
          }
        }
      ]
    },
    {
      "key": "postes",
      "label": "Postes",
      "icon": "briefcase",
      "color": "#6366f1",
      "fields": [
        { "label": "Intitulé", "kind": "short_text", "required": true },
        {
          "label": "Service",
          "kind": "select",
          "options": ["Technique", "Commercial", "Support", "Marketing", "Administration"]
        },
        { "label": "Contrat", "kind": "select", "options": ["CDI", "CDD", "Stage", "Alternance"] },
        { "label": "Lieu", "kind": "short_text" },
        { "label": "Ouvert", "kind": "boolean" },
        { "label": "Description", "kind": "long_text" },
        {
          "label": "Candidatures",
          "kind": "count",
          "rollup": { "via": "Poste", "table": "candidats" }
        }
      ]
    },
    {
      "key": "entretiens",
      "label": "Entretiens",
      "icon": "calendar",
      "color": "#f59e0b",
      "fields": [
        { "label": "Titre", "kind": "short_text", "required": true },
        { "label": "Date", "kind": "datetime" },
        {
          "label": "Type",
          "kind": "select",
          "options": ["Téléphone", "Visio", "Sur place", "Cas pratique"]
        },
        { "label": "Intervieweur", "kind": "user" },
        {
          "label": "Avis",
          "kind": "select",
          "options": [
            { "label": "Favorable", "color": "#10b981" },
            { "label": "Réservé", "color": "#f59e0b" },
            { "label": "Défavorable", "color": "#ef4444" }
          ]
        },
        { "label": "Compte rendu", "kind": "long_text" }
      ]
    }
  ],
  "links": [
    { "from": "candidats", "label": "Poste", "to": "postes" },
    { "from": "entretiens", "label": "Candidat", "to": "candidats" }
  ],
