  },
  "views": [
    {
      "table": "evenements",
      "label": "Calendrier",
      "kind": "calendar",
      "spec": {
        "date_field": "Début",
        "end_field": "Fin",
        "color_field": "Type",
        "card_fields": ["Lieu", "Places restantes"]
      }
    },
    {
      "table": "evenements",
      "label": "Affiches",
      "kind": "gallery",
      "spec": {
        "card_fields": ["Type", "Début", "Lieu", "Places restantes"],
        "color_field": "Statut",
        "card_size": "large"
      }
    },
    {
      "table": "inscriptions",
      "label": "Suivi",
      "kind": "kanban",
      "spec": {
        "group_by": "Statut",
        "card_fields": ["Événement", "Inscrit le"],
        "group_order": ["Inscrit", "Confirmé", "Présent", "Absent", "Annulé"]
      }
    },
    {
      "table": "inscriptions",
      "label": "Retours",
      "kind": "list",
      "spec": {
        "filter": "not [Retour] is_null",
        "group_by": "Sentiment",
        "card_fields": ["Événement", "Retour", "À retenir"]
      }
    },
    {
      "table": "participants",
      "label": "Rejoindre la liste",
      "kind": "form",
      "spec": {
        "title": "Rester informé de nos événements",
        "description": "Laissez vos coordonnées : nous vous prévenons de chaque nouvel événement qui vous concerne.",
        "fields": [
          { "field": "Nom", "required": true, "label": "Prénom et nom" },
          { "field": "E-mail", "required": true },
          { "field": "Entreprise" },
          { "field": "Centres d'intérêt" }
        ],
        "submit_label": "M'inscrire à la liste",
        "success_message": "C'est noté, à bientôt !"
      }
    }
  ],
  "dashboards": [
    {
      "label": "Événements",
      "blocks": [
        {
          "kind": "number",
          "title": "Événements à venir",
          "table": "evenements",
          "aggregate": "count",
          "filter": "[Statut] ne \"Terminé\""
        },
        {
          "kind": "number",
          "title": "Inscriptions",
          "table": "inscriptions",
          "aggregate": "count"
        },
        {
          "kind": "number",
          "title": "Participants",
          "table": "participants",
          "aggregate": "count"
        },
        {
          "kind": "chart",
          "title": "Inscriptions par statut",
          "table": "inscriptions",
          "group_by": "Statut",
          "style": "bar",
          "width": 2
        },
        {
          "kind": "chart",
          "title": "Sentiment des retours",
          "table": "inscriptions",
          "group_by": "Sentiment",
          "style": "pie"
        },
        {
          "kind": "list",
          "title": "Prochains événements",
          "table": "evenements",
          "fields": ["Nom", "Début", "Places restantes"],
          "filter": "[Statut] ne \"Terminé\"",
          "sort": "Début",
          "limit": 5,
          "width": 3
        }
      ]
    }
  ],
  "automations": [
    {
      "label": "Date d'inscription",
      "description": "Note la date de chaque nouvelle inscription.",
      "trigger": { "kind": "record_created", "table": "inscriptions" },
      "actions": [{ "kind": "update_record", "values": { "Inscrit le": "{{_maintenant}}" } }]
    }
  ]
}
