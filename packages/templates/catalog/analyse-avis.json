{
  "format": 1,
  "key": "analyse-avis",
  "label": "Analyse d'avis clients",
  "summary": "Collectez les avis, laissez l'IA en tirer le sentiment, les thèmes, l'urgence et un brouillon de réponse.",
  "description": "Pour un commerce, un restaurant ou une marque : les avis arrivent d'un formulaire public ou d'un import, et l'IA lit chacun d'eux. Elle classe le sentiment, repère le thème principal, signale ceux qui demandent une réponse rapide, extrait la suggestion du client et rédige une réponse à relire. Les produits cumulent leur note moyenne et leur nombre d'avis ; un tableau de bord suit la satisfaction.",
  "category": "Relation client",
  "icon": "message-square",
  "color": "#ec4899",
  "tags": ["IA", "Formulaire", "Tableau de bord"],
  "base": {
    "label": "Avis clients",
    "description": "Les avis des clients, lus et classés par l'IA, pour savoir ce qui plaît et ce qui fâche."
  },
  "tables": [
    {
      "key": "avis",
      "label": "Avis",
      "icon": "message-square",
      "color": "#ec4899",
      "description": "Un avis par ligne, d'où qu'il vienne.",
      "fields": [
        { "label": "Auteur", "kind": "short_text", "required": true },
        { "label": "Avis", "kind": "long_text", "description": "Le texte du client, tel quel." },
        { "label": "Note", "kind": "number", "format": { "display": "rating", "rating_max": 5 } },
        {
          "label": "Source",
          "kind": "select",
          "options": ["Site web", "Google", "Formulaire", "E-mail", "En boutique"]
        },
        { "label": "Reçu le", "kind": "date" },
        {
          "label": "Sentiment",
          "kind": "select",
          "options": [
            { "label": "Très positif", "color": "#059669", "icon": "laugh" },
            { "label": "Positif", "color": "#10b981", "icon": "smile" },
            { "label": "Mitigé", "color": "#f59e0b", "icon": "meh" },
            { "label": "Négatif", "color": "#ef4444", "icon": "frown" },
            { "label": "Très négatif", "color": "#b91c1c", "icon": "angry" }
          ],
          "ai": {
            "prompt": "Voici un avis client, noté {{Note}}/5 :\n« {{Avis}} »\nQuel est son sentiment global ?"
          }
        },
        {
          "label": "Thème",
          "kind": "select",
          "options": [
            "Qualité du produit",
            "Prix",
            "Livraison",
            "Service client",
            "Site et commande",
            "Autre"
          ],
          "ai": { "prompt": "Quel est le sujet principal de cet avis client ?\n« {{Avis}} »" }
        },
        {
          "label": "Réponse urgente",
          "kind": "boolean",
          "ai": {
            "prompt": "Cet avis demande-t-il une réponse rapide de l'entreprise (client en colère, problème non résolu, risque de mauvaise publicité, question posée) ?\n« {{Avis}} » ({{Note}}/5)"
          }
        },
        {
          "label": "Suggestion du client",
          "kind": "short_text",
          "ai": {
            "prompt": "Si ce client suggère une amélioration concrète, résume-la en 12 mots au plus ; sinon réponds par une chaîne vide.\n« {{Avis}} »"
          }
        },
        {
          "label": "Réponse proposée",
          "kind": "long_text",
          "ai": {
            "prompt": "Rédige une réponse publique à cet avis, en trois phrases au plus : remercie, réponds précisément à ce que dit le client, propose une solution s'il y a un problème. Ton chaleureux et professionnel, vouvoiement, sans formule creuse.\nAvis de {{Auteur}} ({{Note}}/5) : « {{Avis}} »"
          }
        },
        {
          "label": "Traité",
          "kind": "boolean",
          "description": "Coché quand la réponse a été publiée."
        }
      ]
    },
    {
      "key": "produits",
      "label": "Produits",
      "icon": "package",
      "color": "#8b5cf6",
      "description": "Ce sur quoi portent les avis.",
      "fields": [
        { "label": "Nom", "kind": "short_text", "required": true },
        { "label": "Gamme", "kind": "select", "options": ["Cafés", "Thés", "Accessoires"] },
        {
          "label": "Prix",
          "kind": "number",
          "format": { "display": "currency", "currency": "EUR" }
        },
        { "label": "Avis", "kind": "count", "rollup": { "via": "Produit", "table": "avis" } },
        {
          "label": "Note moyenne",
          "kind": "rollup",
          "rollup": { "via": "Produit", "table": "avis", "target": "Note", "aggregate": "avg" }
        },
        {
          "label": "Note la plus basse",
          "kind": "rollup",
          "rollup": { "via": "Produit", "table": "avis", "target": "Note", "aggregate": "min" }
        }
      ]
    }
  ],
  "links": [{ "from": "avis", "label": "Produit", "to": "produits" }],
