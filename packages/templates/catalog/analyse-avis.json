  },
  "views": [
    {
      "table": "avis",
      "label": "À traiter",
      "kind": "grid",
      "spec": {
        "filter": "[Traité] eq false",
        "sorts": [{ "field": "Reçu le", "direction": "desc" }],
        "color_field": "Sentiment"
      }
    },
    {
      "table": "avis",
      "label": "Urgents",
      "kind": "list",
      "spec": {
        "filter": "[Réponse urgente] eq true and [Traité] eq false",
        "card_fields": ["Sentiment", "Thème", "Note", "Réponse proposée"]
      }
    },
    {
      "table": "avis",
      "label": "Par sentiment",
      "kind": "kanban",
      "spec": {
        "group_by": "Sentiment",
        "card_fields": ["Note", "Thème", "Produit"],
        "group_order": ["Très négatif", "Négatif", "Mitigé", "Positif", "Très positif"]
      }
    },
    {
      "table": "avis",
      "label": "Par thème",
      "kind": "list",
      "spec": { "group_by": "Thème", "card_fields": ["Sentiment", "Note", "Suggestion du client"] }
    },
    {
      "table": "avis",
      "label": "Laisser un avis",
      "kind": "form",
      "spec": {
        "title": "Votre avis compte",
        "description": "Dites-nous ce que vous avez pensé de votre commande.",
        "fields": [
          {
            "field": "Auteur",
            "required": true,
            "label": "Votre prénom et l'initiale de votre nom"
          },
          { "field": "Note", "required": true },
          { "field": "Avis", "required": true, "label": "Votre avis" }
        ],
        "submit_label": "Publier mon avis",
        "success_message": "Merci pour votre avis !"
      }
    },
    {
      "table": "produits",
      "label": "Catalogue",
      "kind": "gallery",
      "spec": { "card_fields": ["Gamme", "Prix", "Note moyenne", "Avis"], "card_size": "medium" }
    }
  ],
  "dashboards": [
    {
      "label": "Satisfaction",
      "blocks": [
        {
          "kind": "number",
          "title": "Note moyenne",
          "table": "avis",
          "aggregate": "avg",
          "field": "Note"
        },
        {
          "kind": "number",
          "title": "Avis à traiter",
          "table": "avis",
          "aggregate": "count",
          "filter": "[Traité] eq false"
        },
        {
          "kind": "number",
          "title": "Réponses urgentes",
          "table": "avis",
          "aggregate": "count",
          "filter": "[Réponse urgente] eq true and [Traité] eq false"
        },
        {
          "kind": "chart",
          "title": "Sentiment",
          "table": "avis",
          "group_by": "Sentiment",
          "style": "pie"
        },
        {
          "kind": "chart",
          "title": "Thèmes abordés",
          "table": "avis",
          "group_by": "Thème",
          "style": "bar",
          "width": 2
        },
        {
          "kind": "list",
          "title": "Derniers avis négatifs",
          "table": "avis",
          "fields": ["Auteur", "Note", "Thème"],
          "filter": "[Note] lte 2",
          "sort": "-Reçu le",
          "limit": 5,
          "width": 3
        }
      ]
    }
  ],
  "automations": [
    {
      "label": "Alerte avis urgent",
      "description": "Prévient quand l'IA juge qu'un avis demande une réponse rapide.",
      "trigger": { "kind": "record_updated", "table": "avis", "fields": ["Réponse urgente"] },
      "condition": "[Réponse urgente] eq true",
      "actions": [
        {
          "kind": "notify",
          "users": ["$moi"],
          "message": "Avis urgent de {{Auteur}} ({{Note}}/5) : « {{Avis}} »"
        }
      ]
    }
  ]
}
