# What the image never needs: dependencies and builds are made inside it, secrets
# are given at run time, and the documentation site has a life of its own.
**/node_modules
**/dist
**/.next
**/.turbo
**/*.tsbuildinfo
**/coverage
**/*.log
apps/web/out-static

# The server is built inside the image; its build folders stay outside.
rust-server/target*

.git
.github
.vscode
.claude
.playwright-mcp
.basedb

.env
.env.*
!.env.example

www
docs
docker/trino
*.png
Dockerfile
docker-compose*.yml
